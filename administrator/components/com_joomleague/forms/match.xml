<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="details" label="COM_JOOMLEAGUE_FIELDSET_DETAILS" addfieldprefix="Joomleague\Component\Joomleague\Administrator\Field">
		<field name="project_id" type="hidden" filter="uint" required="true" /><field name="stage_id" type="hidden" filter="uint" required="true" /><field name="round_id" type="hidden" filter="uint" required="true" />
		<field name="match_number" type="text" label="COM_JOOMLEAGUE_FIELD_MATCH_NUMBER_LABEL" description="COM_JOOMLEAGUE_FIELD_MATCH_NUMBER_DESC" maxlength="100" />
		<field name="code" type="text" label="COM_JOOMLEAGUE_FIELD_CODE_LABEL" description="COM_JOOMLEAGUE_FIELD_MATCH_CODE_DESC" maxlength="100" filter="cmd" />
		<field name="contest_type" type="contesttype" label="COM_JOOMLEAGUE_FIELD_CONTEST_TYPE_LABEL" description="COM_JOOMLEAGUE_FIELD_CONTEST_TYPE_DESC" required="true" default="head_to_head" filter="cmd" validate="options" />
		<field name="participant_slot_1" type="matchparticipant" label="COM_JOOMLEAGUE_MATCH_COLUMN_HOME" description="COM_JOOMLEAGUE_FIELD_MATCH_HOME_DESC" required="true" filter="uint" validate="options" showon="contest_type:head_to_head" />
		<field name="participant_slot_2" type="matchparticipant" label="COM_JOOMLEAGUE_MATCH_COLUMN_AWAY" description="COM_JOOMLEAGUE_FIELD_MATCH_AWAY_DESC" required="true" filter="uint" validate="options" showon="contest_type:head_to_head" />
		<field name="participants_note" type="note" label="COM_JOOMLEAGUE_MATCHPARTICIPANTS_TITLE" description="COM_JOOMLEAGUE_FIELD_PARTICIPANTS_NOTE_DESC" showon="contest_type!:head_to_head" />
		<field name="scheduled_date" type="calendar" label="COM_JOOMLEAGUE_MATCH_COLUMN_DATE" description="COM_JOOMLEAGUE_FIELD_MATCH_DATE_DESC" format="%Y-%m-%d" filter="string" todaybutton="true" />
		<field name="scheduled_time" type="time" label="COM_JOOMLEAGUE_MATCH_COLUMN_TIME" description="COM_JOOMLEAGUE_FIELD_MATCH_TIME_DESC" filter="string" />
		<field name="timezone" type="timezone" label="COM_JOOMLEAGUE_FIELD_MATCH_TIMEZONE_LABEL" description="COM_JOOMLEAGUE_FIELD_MATCH_TIMEZONE_DESC"><option value="">COM_JOOMLEAGUE_OPTION_USE_PROJECT_SYSTEM_TIMEZONE</option></field>
		<field name="duration_minutes" type="number" label="COM_JOOMLEAGUE_FIELD_DURATION_MINUTES_LABEL" description="COM_JOOMLEAGUE_FIELD_DURATION_MINUTES_DESC" min="1" filter="uint" />
		<field name="venue_id" type="sql" label="COM_JOOMLEAGUE_FIELD_VENUE_LABEL" description="COM_JOOMLEAGUE_FIELD_MATCH_VENUE_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_venue WHERE published = 1 ORDER BY name" key_field="value" value_field="text"><option value="">COM_JOOMLEAGUE_OPTION_SELECT_VENUE</option></field>
		<field name="attendance" type="number" label="COM_JOOMLEAGUE_FIELD_ATTENDANCE_LABEL" description="COM_JOOMLEAGUE_FIELD_ATTENDANCE_DESC" min="0" filter="uint" />
		<field name="status_code" type="text" label="COM_JOOMLEAGUE_FIELD_MATCH_STATUS_LABEL" description="COM_JOOMLEAGUE_FIELD_MATCH_STATUS_DESC" required="true" default="scheduled" maxlength="100" filter="cmd" />
		<field name="scheduled_start" type="hidden" filter="string" />
	</fieldset>
	<fieldset name="description" label="COM_JOOMLEAGUE_FIELDSET_DESCRIPTION"><field name="description" type="editor" label="COM_JOOMLEAGUE_FIELD_DESCRIPTION_LABEL" description="COM_JOOMLEAGUE_FIELD_MATCH_DESCRIPTION_DESC" filter="safehtml" buttons="true" /></fieldset>
	<fieldset name="publishing" label="JGLOBAL_FIELDSET_PUBLISHING"><field name="published" type="status" label="JSTATUS" description="COM_JOOMLEAGUE_FIELD_PUBLISHED_DESC" default="0" /><field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" description="COM_JOOMLEAGUE_FIELD_ORDERING_DESC" default="0" /><field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" description="JGLOBAL_FIELD_ID_DESC" readonly="true" class="readonly" default="0" /></fieldset>
</form>
