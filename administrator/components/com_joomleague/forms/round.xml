<?xml version='1.0' encoding='UTF-8'?>
<form>
	<fieldset name="details">
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" default="0" />
		<field name="project_id" type="hidden" required="true" />
		<field name="roundcode" type="number" label="COM_JOOMLEAGUE_ROUND_FIELD_CODE" required="true" min="1" description="COM_JOOMLEAGUE_ROUND_FIELD_CODE_DESCRIPTION" />
		<field name="name" type="text" label="COM_JOOMLEAGUE_FIELD_NAME" required="true" description="COM_JOOMLEAGUE_FIELD_NAME_DESCRIPTION" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" />
		<field name="round_date_first" type="calendar" label="COM_JOOMLEAGUE_ROUND_FIELD_FIRST_DATE" format="%Y-%m-%d" showtime="false" description="COM_JOOMLEAGUE_ROUND_FIELD_FIRST_DATE_DESCRIPTION" />
		<field name="round_date_last" type="calendar" label="COM_JOOMLEAGUE_ROUND_FIELD_LAST_DATE" format="%Y-%m-%d" showtime="false" description="COM_JOOMLEAGUE_ROUND_FIELD_LAST_DATE_DESCRIPTION" />
	</fieldset>
	<fieldset name="publishing">
		<field name="published" type="list" label="JSTATUS" default="1">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" />
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_joomleague" section="round" />
	</fieldset>
</form>