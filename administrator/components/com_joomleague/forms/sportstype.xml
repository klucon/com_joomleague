<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="details">
		<field
			name="id"
			type="text"
			label="JGLOBAL_FIELD_ID_LABEL"
			class="readonly"
			readonly="true"
			default="0"
		/>
		<field
			name="name"
			type="text"
			label="COM_JOOMLEAGUE_SPORTSTYPE_FIELD_NAME_LABEL"
			description="COM_JOOMLEAGUE_SPORTSTYPE_FIELD_NAME_DESCRIPTION"
			required="true"
			maxlength="255"
		/>
		<field
			name="periods"
			type="number"
			label="COM_JOOMLEAGUE_SPORTSTYPE_FIELD_PERIODS_LABEL"
			description="COM_JOOMLEAGUE_SPORTSTYPE_FIELD_PERIODS_DESCRIPTION"
			default="2"
			min="1"
			max="9"
		/>
		<field
			name="icon"
			type="media"
			label="COM_JOOMLEAGUE_SPORTSTYPE_FIELD_ICON_LABEL"
			description="COM_JOOMLEAGUE_SPORTSTYPE_FIELD_ICON_DESCRIPTION"
			directory="com_joomleague/database/sport_types"
			preview="tooltip"
		/>
		<field
			name="published"
			type="list"
			label="JSTATUS"
			default="1"
			validate="options"
			class="form-select-color-state"
			>
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>
		<field
			name="ordering"
			type="number"
			label="JFIELD_ORDERING_LABEL"
			default="0"
			min="0"
		/>
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_joomleague" section="sportstype" />
	</fieldset>
</form>
