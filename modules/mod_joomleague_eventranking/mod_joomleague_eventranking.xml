<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
  <name>mod_joomleague_eventranking</name>
  <author>Ondřej Klučka (https://joomleague.eu)</author>
  <creationDate>2026-08</creationDate>
  <copyright>(C) 2026 Ondřej Klučka (https://klucon.cz).</copyright>
  <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
  <version>6.2.0-rc2</version>
  <description>MOD_JOOMLEAGUE_EVENTRANKING_XML_DESCRIPTION</description>
  <namespace path="src">Joomleague\Module\Eventranking</namespace>
  <files><folder module="mod_joomleague_eventranking">services</folder><folder>fields</folder><folder>rules</folder><folder>src</folder><folder>tmpl</folder></files>
  <languages>
    <language tag="en-GB">language/en-GB/mod_joomleague_eventranking.ini</language>
    <language tag="en-GB">language/en-GB/mod_joomleague_eventranking.sys.ini</language>
    
    
  </languages>
  <config><fields name="params" addfieldpath="modules/mod_joomleague_eventranking/fields" addrulepath="modules/mod_joomleague_eventranking/rules">
    <fieldset name="basic">
      <field name="project_id" type="sql" required="true" label="MOD_JOOMLEAGUE_EVENTRANKING_PROJECT_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_PROJECT_DESC" query="SELECT id AS value,COALESCE(NULLIF(name,''),CONCAT('ID ',id)) AS text FROM #__joomleague_project WHERE published=1 ORDER BY name,id" key_field="value" value_field="text"/>
      <field name="event_code" type="event" validate="rankingselector" label="MOD_JOOMLEAGUE_EVENTRANKING_EVENT_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_EVENT_DESC"><option value="">MOD_JOOMLEAGUE_EVENTRANKING_EVENT_AUTO</option></field>
      <field name="stage_id" type="rankingstage" validate="rankingselector" default="0" filter="integer" label="MOD_JOOMLEAGUE_EVENTRANKING_STAGE_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_STAGE_DESC"><option value="0">MOD_JOOMLEAGUE_EVENTRANKING_ANY</option></field>
      <field name="date_from" type="calendar" filter="string" format="%Y-%m-%d" showtime="false" label="MOD_JOOMLEAGUE_EVENTRANKING_FROM_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_FROM_DESC"/>
      <field name="date_until" type="calendar" filter="string" format="%Y-%m-%d" showtime="false" label="MOD_JOOMLEAGUE_EVENTRANKING_UNTIL_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_UNTIL_DESC"/>
      <field name="participant_kind" type="list" default="any" label="MOD_JOOMLEAGUE_EVENTRANKING_KIND_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_KIND_DESC"><option value="any">MOD_JOOMLEAGUE_EVENTRANKING_ANY</option><option value="person">MOD_JOOMLEAGUE_EVENTRANKING_PERSON</option><option value="team">MOD_JOOMLEAGUE_EVENTRANKING_TEAM</option><option value="participant">MOD_JOOMLEAGUE_EVENTRANKING_PARTICIPANT</option></field>
      <field name="direction" type="list" default="desc" label="MOD_JOOMLEAGUE_EVENTRANKING_DIRECTION_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_DIRECTION_DESC"><option value="desc">MOD_JOOMLEAGUE_EVENTRANKING_DESCENDING</option><option value="asc">MOD_JOOMLEAGUE_EVENTRANKING_ASCENDING</option></field>
      <field name="ties" type="list" default="ordinal" label="MOD_JOOMLEAGUE_EVENTRANKING_TIES_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_TIES_DESC"><option value="ordinal">MOD_JOOMLEAGUE_EVENTRANKING_ORDINAL</option><option value="competition">MOD_JOOMLEAGUE_EVENTRANKING_COMPETITION</option><option value="dense">MOD_JOOMLEAGUE_EVENTRANKING_DENSE</option></field>
      <field name="limit" type="number" default="5" min="1" max="100" label="MOD_JOOMLEAGUE_EVENTRANKING_LIMIT_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_LIMIT_DESC"/>
      <field name="show_project_name" type="radio" default="1" label="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_PROJECT_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_PROJECT_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
      <field name="show_event_name" type="radio" default="0" label="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_EVENT_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_EVENT_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
      <field name="show_rank" type="radio" default="1" label="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_RANK_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_RANK_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
      <field name="show_value" type="radio" default="1" label="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_VALUE_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_VALUE_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
      <field name="show_appearances" type="radio" default="0" label="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_APPEARANCES_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_APPEARANCES_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
      <field name="link_target" type="radio" default="1" label="MOD_JOOMLEAGUE_EVENTRANKING_LINK_TARGET_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_LINK_TARGET_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
      <field name="show_all_link" type="radio" default="1" label="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_ALL_LINK_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_ALL_LINK_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
      <field name="show_empty" type="radio" default="1" label="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_EMPTY_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_EMPTY_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
      <field name="orientation" type="list" default="vertical" label="MOD_JOOMLEAGUE_EVENTRANKING_ORIENTATION_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_ORIENTATION_DESC"><option value="vertical">MOD_JOOMLEAGUE_EVENTRANKING_VERTICAL</option><option value="horizontal">MOD_JOOMLEAGUE_EVENTRANKING_HORIZONTAL</option></field>
      <field name="density" type="list" default="standard" label="MOD_JOOMLEAGUE_EVENTRANKING_DENSITY_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_DENSITY_DESC"><option value="standard">MOD_JOOMLEAGUE_EVENTRANKING_STANDARD</option><option value="compact">MOD_JOOMLEAGUE_EVENTRANKING_COMPACT</option></field>
      <field name="show_unit" type="radio" default="0" showon="show_value:1" label="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_UNIT_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_SHOW_UNIT_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
      <field name="show_images" type="radio" default="0" label="MOD_JOOMLEAGUE_EVENTRANKING_IMAGES_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_IMAGES_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
      <field name="image_size" type="list" default="48" showon="show_images:1" label="MOD_JOOMLEAGUE_EVENTRANKING_IMAGE_SIZE_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_IMAGE_SIZE_DESC"><option value="32">32 px</option><option value="48">48 px</option><option value="64">64 px</option></field>
      <field name="highlight_target" type="rankingtarget" validate="rankingselector" default="" label="MOD_JOOMLEAGUE_EVENTRANKING_HIGHLIGHT_LABEL" description="MOD_JOOMLEAGUE_EVENTRANKING_HIGHLIGHT_DESC"><option value="">JNONE</option></field>
    </fieldset>
  </fields></config>
</extension>
