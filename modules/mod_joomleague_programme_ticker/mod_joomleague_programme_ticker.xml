<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>mod_joomleague_programme_ticker</name><author>Ondřej Klučka (https://klucon.cz)</author><creationDate>2026-09</creationDate><copyright>(C) 2026 Ondřej Klučka (https://klucon.cz).</copyright><license>GNU General Public License version 2 or later; see LICENSE.txt</license><version>6.2.0-dev7</version><description>MOD_JOOMLEAGUE_PROGRAMME_TICKER_XML_DESCRIPTION</description>
	<namespace path="src">Joomleague\Module\ProgrammeTicker</namespace>
	<files><folder module="mod_joomleague_programme_ticker">services</folder><folder>src</folder><folder>tmpl</folder></files>
	<languages><language tag="en-GB">language/en-GB/mod_joomleague_programme_ticker.ini</language><language tag="en-GB">language/en-GB/mod_joomleague_programme_ticker.sys.ini</language><language tag="cs-CZ">language/cs-CZ/mod_joomleague_programme_ticker.ini</language><language tag="cs-CZ">language/cs-CZ/mod_joomleague_programme_ticker.sys.ini</language></languages>
	<config><fields name="params"><fieldset name="basic">
		<field name="sport_type_id" type="sql" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SPORT_LABEL" description="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SPORT_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_sport_type WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_PROGRAMME_TICKER_ALL_SPORTS</option></field>
		<field name="club_id" type="sql" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_CLUB_LABEL" description="MOD_JOOMLEAGUE_PROGRAMME_TICKER_CLUB_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_club WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_PROGRAMME_TICKER_ALL_CLUBS</option></field>
		<field name="days_before" type="number" default="30" min="0" max="5000" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_DAYS_BEFORE_LABEL" description="MOD_JOOMLEAGUE_PROGRAMME_TICKER_DAYS_BEFORE_DESC" />
		<field name="days_after" type="number" default="30" min="1" max="5000" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_DAYS_AFTER_LABEL" description="MOD_JOOMLEAGUE_PROGRAMME_TICKER_DAYS_AFTER_DESC" />
		<field name="completed_limit" type="number" default="3" min="0" max="20" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_COMPLETED_LIMIT_LABEL" description="MOD_JOOMLEAGUE_PROGRAMME_TICKER_COMPLETED_LIMIT_DESC" />
		<field name="upcoming_limit" type="number" default="5" min="0" max="20" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_UPCOMING_LIMIT_LABEL" description="MOD_JOOMLEAGUE_PROGRAMME_TICKER_UPCOMING_LIMIT_DESC" />
		<field name="show_project" type="radio" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_PROJECT_LABEL" description="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_PROJECT_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
		<field name="show_date" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_DATE_LABEL" description="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_DATE_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
		<field name="show_result" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_RESULT_LABEL" description="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_RESULT_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
		<field name="template_show_match_detail_button" type="list" default="" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_DETAIL_LABEL" description="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_DETAIL_DESC"><option value="">MOD_JOOMLEAGUE_PROGRAMME_TICKER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
	</fieldset><fieldset name="advanced"><field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout" /><field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier" /><field name="cache" type="list" default="1" label="COM_MODULES_FIELD_CACHING_LABEL"><option value="1">JGLOBAL_USE_GLOBAL</option><option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option></field><field name="cache_time" type="number" default="300" label="COM_MODULES_FIELD_CACHE_TIME_LABEL" /><field name="cachemode" type="hidden" default="id" /></fieldset></fields></config>
</extension>
