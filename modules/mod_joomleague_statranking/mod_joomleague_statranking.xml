<?xml version='1.0' encoding='UTF-8'?>
<extension type="module" client="site" method="upgrade">
	<name>mod_joomleague_statranking</name>
	<author>Ondřej Klučka (https://klucon.cz)</author>
	<authorEmail>info@klucon.cz</authorEmail>
	<creationDate>2026-06</creationDate>
	<copyright>(C) 2026 Ondřej Klučka (https://klucon.cz).</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>0.35.1</version>
	<description>MOD_JOOMLEAGUE_STATRANKING_XML_DESCRIPTION</description>
	<namespace path="src">Joomleague\Module\Statranking</namespace>
	<files>
		<folder module="mod_joomleague_statranking">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_joomleague_statranking.ini</language>
		<language tag="en-GB">language/en-GB/mod_joomleague_statranking.sys.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_statranking.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_statranking.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic" addfieldpath="/administrator/components/com_joomleague/models/fields">
				<field name="p" type="sql" label="MOD_JOOMLEAGUE_STATRANKING_SELECT_PROJECT_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_SELECT_PROJECT_DESCR" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_project ORDER BY name, id" key_field="value" value_field="text" />
				<field name="division_id" type="sql" depends="p" task="projectdivisionsoptions" label="MOD_JOOMLEAGUE_STATRANKING_SELECT_DIVISION_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_SELECT_DIVISION_DESCR" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_division ORDER BY name, id" key_field="value" value_field="text" />
				<field name="tid" type="sql" depends="p,division_id" task="projectteamsbydivisionoptions" label="MOD_JOOMLEAGUE_STATRANKING_SELECT_TEAM_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_SELECT_TEAM_DESCR" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_team ORDER BY name, id" key_field="value" value_field="text" />
				<field name="sid" type="sql" depends="p" task="projectstatsoptions" label="MOD_JOOMLEAGUE_STATRANKING_SELECT_STAT_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_SELECT_STAT_DESCR" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_statistic ORDER BY ordering, name, id" key_field="value" value_field="text" multiple="true" />
				<field name="ranking_order" type="radio" default="DESC" label="MOD_JOOMLEAGUE_STATRANKING_STAT_RANKING_ORDER" description="MOD_JOOMLEAGUE_STATRANKING_STAT_RANKING_ORDER_DESC">
					<option value="ASC">Ascending</option>
					<option value="DESC">Descending</option>
				</field>
				<field name="limit" type="text" default="5" label="MOD_JOOMLEAGUE_STATRANKING_ROW_LIMIT_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_ROW_LIMIT_LABEL_DESC" />
				<field name="show_project_name" type="list" default="0" label="MOD_JOOMLEAGUE_STATRANKING_SHOW_PROJECT_NAME" description="MOD_JOOMLEAGUE_STATRANKING_SHOW_PROJECT_NAME_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="show_division_name" type="list" default="0" label="MOD_JOOMLEAGUE_STATRANKING_SHOW_DIVISION_NAME" description="MOD_JOOMLEAGUE_STATRANKING_SHOW_DIVISION_NAME_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="show_full_link" type="radio" default="1" label="MOD_JOOMLEAGUE_STATRANKING_SHOW_FULL_LINK" description="MOD_JOOMLEAGUE_STATRANKING_SHOW_FULL_LINK_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="spacer_10" type="spacer" default="" label="" description="" />
				<field name="name_format" type="list" label="COM_JOOMLEAGUE_FES_PLAYER_PARAM_LABEL_NAME_FORMAT" description="COM_JOOMLEAGUE_FES_PLAYER_PARAM_DESCR_NAME_FORMAT">
					<option value="0">MOD_JOOMLEAGUE_NAME_FORMAT_FIRST_LAST</option>
					<option value="1">MOD_JOOMLEAGUE_NAME_FORMAT_LAST_FIRST</option>
					<option value="2">MOD_JOOMLEAGUE_NAME_FORMAT_NICKNAME</option>
				</field>
				<field name="show_picture" type="list" default="0" label="MOD_JOOMLEAGUE_STATRANKING_SHOW_PICTURE_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_SHOW_PICTURE_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="picture_height" type="text" default="20" label="MOD_JOOMLEAGUE_STATRANKING_PICTURE_HEIGHT_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_PICTURE_HEIGHT_DESC" />
				<field name="picture_width" type="text" default="0" label="MOD_JOOMLEAGUE_STATRANKING_PICTURE_WIDTH_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_PICTURE_WIDTH_DESC" />
				<field name="show_player_link" type="list" default="1" label="MOD_JOOMLEAGUE_STATRANKING_SHOW_PLAYER_LINK_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_SHOW_PLAYER_LINK_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="spacer_16" type="spacer" default="" label="" description="" />
				<field name="show_team" type="radio" default="1" label="MOD_JOOMLEAGUE_STATRANKING_SHOW_TEAM_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_SHOW_TEAM_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="teamnametype" type="list" default="short_name" label="MOD_JOOMLEAGUE_STATRANKING_TEAM_NAME_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_TEAM_NAME_DESC">
					<option value="short_name">TEAM NAME SHORT</option>
					<option value="middle_name">TEAM NAME MEDIUM</option>
					<option value="name">TEAM NAME FULL</option>
				</field>
				<field name="teamlink" type="list" default="teaminfo" label="MOD_JOOMLEAGUE_STATRANKING_TEAM_LINK_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_TEAM_LINK_DESC">
					<option value="">LINK NO LINK</option>
					<option value="teaminfo">LINK TEAMINFO</option>
					<option value="roster">LINK ROSTER</option>
					<option value="teamplan">LINK TEAMPLAN</option>
					<option value="clubinfo">LINK CLUBINFO</option>
				</field>
				<field name="show_logo" type="list" default="0" label="MOD_JOOMLEAGUE_STATRANKING_SHOW_LOGO_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_SHOW_LOGO_LABEL_DESC">
					<option value="0">No</option>
					<option value="1">Club Logo</option>
					<option value="2">Country Flag</option>
					<option value="3">Team</option>
					<option value="4">ProjectTeam</option>
				</field>
				<field name="spacer_21" type="spacer" default="" label="" description="" />
				<field name="show_event_icon" type="radio" default="1" label="MOD_JOOMLEAGUE_STATRANKING_SHOW_STATISTIC_ICON_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_SHOW_STATISTIC_ICON_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="cache" type="list" default="1" label="MOD_JOOMLEAGUE_STATRANKING_CACHING_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_CACHING_DESCR">
					<option value="1">MOD_JOOMLEAGUE_STATRANKING_CACHING_USE_GLOBAL</option>
					<option value="0">MOD_JOOMLEAGUE_STATRANKING_CACHING_NO_CACHING</option>
				</field>
				<field name="cache_time" type="text" default="900" label="MOD_JOOMLEAGUE_STATRANKING_CACHE_TIME_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_CACHE_TIME_DESCR">
				</field>
				<field name="moduleclass_sfx" type="text" default="" label="MOD_JOOMLEAGUE_STATRANKING_MODULE_CLASS_SUFFIX_LABEL" description="MOD_JOOMLEAGUE_STATRANKING_MODULE_CLASS_SUFFIX_DESCR">
				</field>
				<field name="style_class1" type="text" default="sectiontableentry1" label="MOD_JOOMLEAGUE_STATRANKING_PARAM_LABEL_STYLE_ODD" description="MOD_JOOMLEAGUE_STATRANKING_PARAM_DESCR_STYLE_ODD">
				</field>
				<field name="style_class2" type="text" default="sectiontableentry2" label="MOD_JOOMLEAGUE_STATRANKING_PARAM_LABEL_STYLE_EVEN" description="MOD_JOOMLEAGUE_STATRANKING_PARAM_DESCR_STYLE_EVEN">
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" />
			</fieldset>
		</fields>
	</config>
</extension>