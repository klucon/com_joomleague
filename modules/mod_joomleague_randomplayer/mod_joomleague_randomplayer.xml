<?xml version='1.0' encoding='UTF-8'?>
<extension type="module" client="site" method="upgrade">
	<name>mod_joomleague_randomplayer</name>
	<author>Ondřej Klučka (https://klucon.cz)</author>
	<authorEmail>info@klucon.cz</authorEmail>
	<creationDate>2026-06</creationDate>
	<copyright>(C) 2026 Ondřej Klučka (https://klucon.cz).</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>6.1.0-alpha-50</version>
	<description>MOD_JOOMLEAGUE_RANDOMPLAYER_XML_DESCRIPTION</description>
	<namespace path="src">Joomleague\Module\Randomplayer</namespace>
	<files>
		<folder module="mod_joomleague_randomplayer">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_joomleague_randomplayer.ini</language>
		<language tag="de-DE">language/de-DE/mod_joomleague_randomplayer.ini</language>
		<language tag="en-GB">language/en-GB/mod_joomleague_randomplayer.sys.ini</language>
		<language tag="de-DE">language/de-DE/mod_joomleague_randomplayer.sys.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_randomplayer.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_randomplayer.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic" addfieldpath="/administrator/components/com_joomleague/models/fields">
				<field name="projects" type="sql" default="" required="true" label="MOD_JOOMLEAGUE_RANDOMPLAYER_PROJECT_ID_LABEL" description="MOD_JOOMLEAGUE_RANDOMPLAYER_PROJECT_ID_LABEL_DESC" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_project ORDER BY name, id" key_field="value" value_field="text" multiple="true" />
				<field name="teams" type="sql" default="" label="MOD_JOOMLEAGUE_RANDOMPLAYER_TEAM_ID_LABEL" description="MOD_JOOMLEAGUE_RANDOMPLAYER_TEAM_ID_LABEL_DESC" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_team ORDER BY name, id" key_field="value" value_field="text" multiple="true" />
				<field name="show_project_name" type="radio" default="1" label="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_PROJECT_NAME" description="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_PROJECT_NAME_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="show_team_name" type="radio" default="1" label="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_TEAM_NAME" description="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_TEAM_NAME_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="show_team_link" type="radio" default="1" label="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_TEAM_LINK" description="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_TEAM_LINK_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="show_position_name" type="radio" default="1" label="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_POSITION_NAME" description="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_POSITION_NAME_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="show_player_link" type="radio" default="1" label="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_PLAYER_LINK" description="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_PLAYER_LINK_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="show_player_flag" type="radio" default="1" label="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_PLAYER_FLAG" description="MOD_JOOMLEAGUE_RANDOMPLAYER_SHOW_PLAYER_FLAG_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="name_format" type="list" label="COM_JOOMLEAGUE_FES_PLAYER_PARAM_LABEL_NAME_FORMAT" description="COM_JOOMLEAGUE_FES_PLAYER_PARAM_DESCR_NAME_FORMAT">
					<option value="0">MOD_JOOMLEAGUE_NAME_FORMAT_FIRST_LAST</option>
					<option value="1">MOD_JOOMLEAGUE_NAME_FORMAT_LAST_FIRST</option>
					<option value="2">MOD_JOOMLEAGUE_NAME_FORMAT_NICKNAME</option>
				</field>
				<field name="picture_width" type="text" default="0" label="MOD_JOOMLEAGUE_RANDOMPLAYER_PICTURE_WIDTH" description="MOD_JOOMLEAGUE_RANDOMPLAYER_PICTURE_WIDTH_DESC" />
				<field name="picture_height" type="text" default="50" label="MOD_JOOMLEAGUE_RANDOMPLAYER_PICTURE_HEIGHT" description="MOD_JOOMLEAGUE_RANDOMPLAYER_PICTURE_HEIGHT_DESC" />
				<field name="team_picture_width" type="text" default="21" label="MOD_JOOMLEAGUE_RANDOMPLAYER_TEAM_PICTURE_WIDTH" description="MOD_JOOMLEAGUE_RANDOMPLAYER_TEAM_PICTURE_WIDTH_DESC" />
				<field name="team_picture_height" type="text" default="0" label="MOD_JOOMLEAGUE_RANDOMPLAYER_TEAM_PICTURE_HEIGHT" description="MOD_JOOMLEAGUE_RANDOMPLAYER_TEAM_PICTURE_HEIGHT_DESC" />
			</fieldset>
			<fieldset name="advanced">
				<field name="cache" type="list" default="1" label="MOD_JOOMLEAGUE_RANDOMPLAYER_CACHING_LABEL" description="MOD_JOOMLEAGUE_RANDOMPLAYER_CACHING_DESCR">
					<option value="1">MOD_JOOMLEAGUE_RANDOMPLAYER_CACHING_USE_GLOBAL</option>
					<option value="0">MOD_JOOMLEAGUE_RANDOMPLAYER_CACHING_NO_CACHING</option>
				</field>
				<field name="cache_time" type="text" default="900" label="MOD_JOOMLEAGUE_RANDOMPLAYER_CACHE_TIME_LABEL" description="MOD_JOOMLEAGUE_RANDOMPLAYER_CACHE_TIME_DESCR">
				</field>
				<field name="moduleclass_sfx" type="text" default="" label="MOD_JOOMLEAGUE_RANDOMPLAYER_MODULE_CLASS_SUFFIX_LABEL" description="MOD_JOOMLEAGUE_RANDOMPLAYER_MODULE_CLASS_SUFFIX_DESCR">
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" />
			</fieldset>
		</fields>
	</config>
</extension>
