<?xml version='1.0' encoding='UTF-8'?>
<extension type="module" client="site" method="upgrade">
	<name>mod_joomleague_sports_type_statistics</name>
	<author>Ondřej Klučka (https://klucon.cz)</author>
	<authorEmail>info@klucon.cz</authorEmail>
	<creationDate>2026-06</creationDate>
	<copyright>(C) 2026 Ondřej Klučka (https://klucon.cz).</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>0.40.4</version>
	<description>MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_XML_DESCRIPTION</description>
	<namespace path="src">Joomleague\Module\SportsTypeStatistics</namespace>
	<files>
		<folder module="mod_joomleague_sports_type_statistics">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_joomleague_sports_type_statistics.ini</language>
		<language tag="de-DE">language/de-DE/mod_joomleague_sports_type_statistics.ini</language>
		<language tag="en-GB">language/en-GB/mod_joomleague_sports_type_statistics.sys.ini</language>
		<language tag="de-DE">language/de-DE/mod_joomleague_sports_type_statistics.sys.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_sports_type_statistics.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_sports_type_statistics.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic" addfieldpath="/administrator/components/com_joomleague/models/fields">
				<field name="sportstypes" type="sql" default="1" required="true" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SPORTS_TYPE_LABEL" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SPORTS_TYPE_LABEL_DESC" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_sports_type ORDER BY name, id" key_field="value" value_field="text" multiple="true" />
				<field name="show_icon" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_ICON_LABEL" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_ICON_LABEL_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_project" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_PROJECTS" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_PROJECTS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_leagues" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_LEAGUES" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_LEAGUES_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_seasons" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_SEASONS" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_SEASONS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_teams" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_TEAMS" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_TEAMS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_players" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_PLAYERS" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_PLAYERS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_divisions" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_DIVISIONS" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_DIVISIONS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_rounds" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_ROUNDS" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_ROUNDS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_matches" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_MATCHES" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_MATCHES_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_player_events" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_PLAYER_EVENTS" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_PLAYER_EVENTS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="show_player_stats" type="radio" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_PLAYER_STATS" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_SHOW_PLAYER_STATS_DESC">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="cache" type="list" default="1" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_CACHING_LABEL" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_CACHING_DESCR">
					<option value="1">MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_CACHING_USE_GLOBAL
					</option>
					<option value="0">MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_CACHING_NO_CACHING
					</option>
				</field>
				<field name="cache_time" type="text" default="900" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_CACHE_TIME_LABEL" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_CACHE_TIME_DESCR">
				</field>
				<field name="moduleclass_sfx" type="text" default="" label="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_MODULE_CLASS_SUFFIX_LABEL" description="MOD_JOOMLEAGUE_SPORTS_TYPE_STATISTICS_MODULE_CLASS_SUFFIX_DESCR">
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" />
			</fieldset>
		</fields>
	</config>
</extension>
