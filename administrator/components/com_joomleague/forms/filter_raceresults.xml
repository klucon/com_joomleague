<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" label="JSEARCH_FILTER" />
		<field name="published" type="status" label="JOPTION_SELECT_PUBLISHED" onchange="this.form.submit();">
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" onchange="this.form.submit();" default="a.overall_place ASC">
			<option value="a.overall_place ASC">COM_JOOMLEAGUE_RACE_PLACE_ASC</option>
			<option value="a.duration_ms ASC">COM_JOOMLEAGUE_RACE_TIME_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" class="js-select-submit-on-change"/>
	</fields>
</form>
