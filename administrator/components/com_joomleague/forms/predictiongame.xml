<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="details">
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" default="0" />
		<field name="project_id" type="sql" label="COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_PROJECT" required="true" query="SELECT id AS value, name AS text FROM #__joomleague_project ORDER BY id DESC" key_field="value" value_field="text" />
		<field name="name" type="text" label="COM_JOOMLEAGUE_FIELD_NAME" required="true" maxlength="128" />
		<field name="deadline_minutes" type="number" label="COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_DEADLINE" description="COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_DEADLINE_DESC" min="0" default="0" />
	</fieldset>
	<fieldset name="rules" label="COM_JOOMLEAGUE_PREDICTIONGAME_FIELDSET_RULES">
		<field name="points_exact" type="number" label="COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_POINTS_EXACT" min="0" default="3" />
		<field name="points_tendency" type="number" label="COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_POINTS_TENDENCY" min="0" default="1" />
		<field name="points_goal_diff" type="number" label="COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_POINTS_GOAL_DIFF" min="0" default="0" />
	</fieldset>
	<fieldset name="options" label="COM_JOOMLEAGUE_PREDICTIONGAME_FIELDSET_OPTIONS">
		<field name="show_ranking" type="radio" label="COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_SHOW_RANKING" layout="joomla.form.field.radio.switcher" default="1"><option value="0">JNO</option><option value="1">JYES</option></field>
	</fieldset>
	<fieldset name="publishing">
		<field name="published" type="list" label="JSTATUS" default="1"><option value="1">JPUBLISHED</option><option value="0">JUNPUBLISHED</option></field>
	</fieldset>
</form>
