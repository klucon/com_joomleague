<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
 <name>mod_joomleague_birthdays</name><author>Ondřej Klučka (https://joomleague.eu)</author><creationDate>2026-09</creationDate><copyright>(C) 2026 Ondřej Klučka.</copyright><license>GNU General Public License version 2 or later; see LICENSE.txt</license><version>6.2.0-rc1</version><description>MOD_JOOMLEAGUE_BIRTHDAYS_XML_DESCRIPTION</description><namespace path="src">Joomleague\Module\Birthdays</namespace>
 <files><folder module="mod_joomleague_birthdays">services</folder><folder>src</folder><folder>tmpl</folder></files><languages><language tag="en-GB">language/en-GB/mod_joomleague_birthdays.ini</language><language tag="en-GB">language/en-GB/mod_joomleague_birthdays.sys.ini</language><language tag="cs-CZ">language/cs-CZ/mod_joomleague_birthdays.ini</language><language tag="cs-CZ">language/cs-CZ/mod_joomleague_birthdays.sys.ini</language></languages>
 <config><fields name="params">
  <fieldset name="basic" label="MOD_JOOMLEAGUE_BIRTHDAYS_FIELDSET_SOURCE">
   <field name="project_id" type="sql" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_PROJECT_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAYS_PROJECT_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_project WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_BIRTHDAYS_ALL_PROJECTS</option></field>
   <field name="club_id" type="sql" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_CLUB_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAYS_CLUB_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_club WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_BIRTHDAYS_ALL_CLUBS</option></field>
   <field name="team_id" type="sql" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_TEAM_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAYS_TEAM_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_team WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_BIRTHDAYS_ALL_TEAMS</option></field>
   <field name="person_types" type="sql" multiple="true" layout="joomla.form.field.list-fancy-select" label="MOD_JOOMLEAGUE_BIRTHDAYS_PERSON_TYPES_LABEL" query="SELECT DISTINCT member_person_type AS value, member_person_type AS text FROM #__joomleague_project_entry_member WHERE member_person_type &lt;&gt; '' UNION SELECT DISTINCT person_type AS value, person_type AS text FROM #__joomleague_project_actor_role WHERE person_type &lt;&gt; '' ORDER BY text" key_field="value" value_field="text"/>
   <field name="role_codes" type="sql" multiple="true" layout="joomla.form.field.list-fancy-select" label="MOD_JOOMLEAGUE_BIRTHDAYS_ROLES_LABEL" query="SELECT DISTINCT role_code AS value, role_code AS text FROM #__joomleague_project_entry_member WHERE role_code IS NOT NULL AND role_code &lt;&gt; '' UNION SELECT DISTINCT role_code AS value, role_code AS text FROM #__joomleague_project_actor_role WHERE role_code &lt;&gt; '' ORDER BY text" key_field="value" value_field="text"/>
  </fieldset>
  <fieldset name="period" label="MOD_JOOMLEAGUE_BIRTHDAYS_FIELDSET_PERIOD">
   <field name="period_mode" type="list" default="rolling" label="MOD_JOOMLEAGUE_BIRTHDAYS_PERIOD_MODE_LABEL"><option value="rolling">MOD_JOOMLEAGUE_BIRTHDAYS_PERIOD_ROLLING</option><option value="current_month">MOD_JOOMLEAGUE_BIRTHDAYS_PERIOD_CURRENT_MONTH</option><option value="selected_month">MOD_JOOMLEAGUE_BIRTHDAYS_PERIOD_SELECTED_MONTH</option></field>
   <field name="selected_month" type="list" default="1" label="MOD_JOOMLEAGUE_BIRTHDAYS_MONTH_LABEL" showon="period_mode:selected_month"><option value="1">JANUARY</option><option value="2">FEBRUARY</option><option value="3">MARCH</option><option value="4">APRIL</option><option value="5">MAY</option><option value="6">JUNE</option><option value="7">JULY</option><option value="8">AUGUST</option><option value="9">SEPTEMBER</option><option value="10">OCTOBER</option><option value="11">NOVEMBER</option><option value="12">DECEMBER</option></field>
   <field name="start_offset" type="number" default="0" min="0" max="366" label="MOD_JOOMLEAGUE_BIRTHDAYS_OFFSET_LABEL" showon="period_mode:rolling"/><field name="days" type="number" default="30" min="0" max="366" label="MOD_JOOMLEAGUE_BIRTHDAYS_DAYS_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAYS_DAYS_DESC" showon="period_mode:rolling"/><field name="limit" type="number" default="10" min="1" max="100" label="MOD_JOOMLEAGUE_BIRTHDAYS_LIMIT_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAYS_LIMIT_DESC"/>
   <field name="order" type="list" default="next_birthday" label="MOD_JOOMLEAGUE_BIRTHDAYS_ORDER_LABEL"><option value="next_birthday">MOD_JOOMLEAGUE_BIRTHDAYS_ORDER_DATE</option><option value="name">MOD_JOOMLEAGUE_BIRTHDAYS_ORDER_NAME</option><option value="age">MOD_JOOMLEAGUE_BIRTHDAYS_ORDER_AGE</option></field><field name="direction" type="list" default="asc" label="MOD_JOOMLEAGUE_BIRTHDAYS_DIRECTION_LABEL"><option value="asc">JGLOBAL_ORDER_ASCENDING</option><option value="desc">JGLOBAL_ORDER_DESCENDING</option></field>
   <field name="include_deceased" type="radio" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_INCLUDE_DECEASED_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAYS_INCLUDE_DECEASED_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
  </fieldset>
  <fieldset name="display" label="MOD_JOOMLEAGUE_BIRTHDAYS_FIELDSET_DISPLAY">
   <field name="orientation" type="list" default="vertical" label="MOD_JOOMLEAGUE_BIRTHDAYS_ORIENTATION_LABEL"><option value="vertical">MOD_JOOMLEAGUE_BIRTHDAYS_ORIENTATION_VERTICAL</option><option value="horizontal">MOD_JOOMLEAGUE_BIRTHDAYS_ORIENTATION_HORIZONTAL</option></field><field name="density" type="list" default="standard" label="MOD_JOOMLEAGUE_BIRTHDAYS_DENSITY_LABEL"><option value="compact">MOD_JOOMLEAGUE_BIRTHDAYS_DENSITY_COMPACT</option><option value="standard">MOD_JOOMLEAGUE_BIRTHDAYS_DENSITY_STANDARD</option><option value="detailed">MOD_JOOMLEAGUE_BIRTHDAYS_DENSITY_DETAILED</option></field>
   <field name="group_by" type="list" default="none" label="MOD_JOOMLEAGUE_BIRTHDAYS_GROUP_LABEL"><option value="none">JNONE</option><option value="day">MOD_JOOMLEAGUE_BIRTHDAYS_GROUP_DAY</option><option value="month">MOD_JOOMLEAGUE_BIRTHDAYS_GROUP_MONTH</option><option value="club">MOD_JOOMLEAGUE_BIRTHDAYS_GROUP_CLUB</option><option value="team">MOD_JOOMLEAGUE_BIRTHDAYS_GROUP_TEAM</option><option value="project">MOD_JOOMLEAGUE_BIRTHDAYS_GROUP_PROJECT</option></field><field name="heading" type="text" filter="string" label="MOD_JOOMLEAGUE_BIRTHDAYS_HEADING_LABEL"/>
   <field name="show_images" type="radio" default="1" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_IMAGES_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_IMAGES_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="image_size" type="list" default="48" label="MOD_JOOMLEAGUE_BIRTHDAYS_IMAGE_SIZE_LABEL" showon="show_images:1"><option value="32">32 px</option><option value="40">40 px</option><option value="48">48 px</option><option value="64">64 px</option><option value="80">80 px</option></field><field name="image_style" type="list" default="cover" label="MOD_JOOMLEAGUE_BIRTHDAYS_IMAGE_STYLE_LABEL" showon="show_images:1"><option value="contain">MOD_JOOMLEAGUE_BIRTHDAYS_IMAGE_CONTAIN</option><option value="cover">MOD_JOOMLEAGUE_BIRTHDAYS_IMAGE_COVER</option><option value="circle">MOD_JOOMLEAGUE_BIRTHDAYS_IMAGE_CIRCLE</option></field>
   <field name="date_format" type="list" default="medium" label="MOD_JOOMLEAGUE_BIRTHDAYS_DATE_FORMAT_LABEL"><option value="short">MOD_JOOMLEAGUE_BIRTHDAYS_FORMAT_SHORT</option><option value="medium">MOD_JOOMLEAGUE_BIRTHDAYS_FORMAT_MEDIUM</option><option value="long">MOD_JOOMLEAGUE_BIRTHDAYS_FORMAT_LONG</option></field>
   <field name="show_nickname" type="radio" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_NICKNAME_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_birth_year" type="radio" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_YEAR_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_age" type="radio" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_AGE_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_AGE_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_days_until" type="radio" default="1" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_DAYS_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
   <field name="show_club" type="radio" default="1" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_CLUB_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_CLUB_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_team" type="radio" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_TEAM_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_project" type="radio" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_PROJECT_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_person_type" type="radio" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_PERSON_TYPE_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_role" type="radio" default="0" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_ROLE_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_deceased" type="radio" default="1" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_DECEASED_LABEL" layout="joomla.form.field.radio.switcher" showon="include_deceased:1"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_person_link" type="radio" default="1" label="MOD_JOOMLEAGUE_BIRTHDAYS_PERSON_LINK_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_empty" type="radio" default="1" label="MOD_JOOMLEAGUE_BIRTHDAYS_SHOW_EMPTY_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
  </fieldset>
  <fieldset name="advanced"><field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout"/><field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier"/><field name="cache" type="list" default="1" label="COM_MODULES_FIELD_CACHING_LABEL"><option value="1">JGLOBAL_USE_GLOBAL</option><option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option></field><field name="cache_time" type="number" default="900" label="COM_MODULES_FIELD_CACHE_TIME_LABEL"/><field name="cachemode" type="hidden" default="id"/></fieldset>
 </fields></config>
</extension>
