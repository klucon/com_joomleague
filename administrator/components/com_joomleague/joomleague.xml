<?xml version="1.0" encoding="UTF-8"?>
<extension type="component" method="upgrade">
	<name>com_joomleague</name>
	<author>Ondřej Klučka (https://klucon.cz)</author>
	<authorEmail>info@klucon.cz</authorEmail>
	<creationDate>2026-06</creationDate>
	<copyright>(C) 2026 Ondřej Klučka (https://klucon.cz).</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>6.1.0-alpha-61</version>
	<description>COM_JOOMLEAGUE_XML_DESCRIPTION</description>
	<namespace path="src">Joomleague\Component\Joomleague</namespace>
	<scriptfile>script.php</scriptfile>

	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>

	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>

	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>

	<media destination="com_joomleague" folder="media/com_joomleague">
		<filename>joomla.asset.json</filename>
		<folder>css</folder>
		<folder>js</folder>
	</media>

	<files folder="components/com_joomleague">
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>

	<languages folder="components/com_joomleague">
		<language tag="cs-CZ">language/cs-CZ/com_joomleague.ini</language>
		<language tag="en-GB">language/en-GB/com_joomleague.ini</language>
		<language tag="de-DE">language/de-DE/com_joomleague.ini</language>
	</languages>

	<administration>
		<menu link="option=com_joomleague&amp;view=dashboard" view="dashboard" img="class:joomla">
			COM_JOOMLEAGUE
		</menu>
		<submenu>
			<menu link="option=com_joomleague&amp;view=dashboard" view="dashboard">COM_JOOMLEAGUE_MENU_DASHBOARD</menu>
			<menu link="option=com_joomleague&amp;view=projects" view="projects">COM_JOOMLEAGUE_MENU_PROJECTS</menu>
			<menu link="option=com_joomleague&amp;view=sportstypes" view="sportstypes">COM_JOOMLEAGUE_MENU_SPORTS_TYPES</menu>
			<menu link="option=com_joomleague&amp;view=leagues" view="leagues">COM_JOOMLEAGUE_MENU_LEAGUES</menu>
			<menu link="option=com_joomleague&amp;view=seasons" view="seasons">COM_JOOMLEAGUE_MENU_SEASONS</menu>
			<menu link="option=com_joomleague&amp;view=clubs" view="clubs">COM_JOOMLEAGUE_MENU_CLUBS</menu>
			<menu link="option=com_joomleague&amp;view=teams" view="teams">COM_JOOMLEAGUE_MENU_TEAMS</menu>
			<menu link="option=com_joomleague&amp;view=persons" view="persons">COM_JOOMLEAGUE_MENU_PERSONS</menu>
			<menu link="option=com_joomleague&amp;view=eventtypes" view="eventtypes">COM_JOOMLEAGUE_MENU_EVENT_TYPES</menu>
			<menu link="option=com_joomleague&amp;view=statistics" view="statistics">COM_JOOMLEAGUE_MENU_STATISTICS</menu>
			<menu link="option=com_joomleague&amp;view=positions" view="positions">COM_JOOMLEAGUE_MENU_POSITIONS</menu>
			<menu link="option=com_joomleague&amp;view=stadiums" view="stadiums">COM_JOOMLEAGUE_MENU_STADIUMS</menu>
			<menu link="option=com_joomleague&amp;view=tools" view="tools">COM_JOOMLEAGUE_TOOLS_TITLE</menu>
		</submenu>
		<files folder="administrator/components/com_joomleague">
			<filename>joomleague.xml</filename>
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<folder>forms</folder>
			<folder>resources</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
		</files>
		<languages folder="administrator/components/com_joomleague">
			<language tag="cs-CZ">language/cs-CZ/com_joomleague.ini</language>
			<language tag="cs-CZ">language/cs-CZ/com_joomleague.sys.ini</language>
			<language tag="en-GB">language/en-GB/com_joomleague.ini</language>
			<language tag="de-DE">language/de-DE/com_joomleague.ini</language>
			<language tag="en-GB">language/en-GB/com_joomleague.sys.ini</language>
			<language tag="de-DE">language/de-DE/com_joomleague.sys.ini</language>
		</languages>
	</administration>
</extension>
