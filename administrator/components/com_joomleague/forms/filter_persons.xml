<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" label="COM_JOOMLEAGUE_FILTER_SEARCH_LABEL" description="COM_JOOMLEAGUE_FILTER_PERSONS_SEARCH_DESC" hint="JSEARCH_FILTER" />
		<field name="published" type="status" label="JOPTION_SELECT_PUBLISHED" onchange="this.form.submit();"><option value="">JOPTION_SELECT_PUBLISHED</option></field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" onchange="this.form.submit();" default="a.last_name ASC">
			<option value="">JGLOBAL_SORT_BY</option><option value="a.last_name ASC">COM_JOOMLEAGUE_PERSON_SORT_LAST_NAME_ASC</option><option value="a.last_name DESC">COM_JOOMLEAGUE_PERSON_SORT_LAST_NAME_DESC</option><option value="a.first_name ASC">COM_JOOMLEAGUE_PERSON_SORT_FIRST_NAME_ASC</option><option value="a.first_name DESC">COM_JOOMLEAGUE_PERSON_SORT_FIRST_NAME_DESC</option><option value="a.id ASC">JGRID_HEADING_ID_ASC</option><option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		
			<option value="a.nickname ASC">COM_JOOMLEAGUE_SORT_A_NICKNAME_ASC</option>
			<option value="a.nickname DESC">COM_JOOMLEAGUE_SORT_A_NICKNAME_DESC</option>
			<option value="a.country_code ASC">COM_JOOMLEAGUE_SORT_A_COUNTRY_CODE_ASC</option>
			<option value="a.country_code DESC">COM_JOOMLEAGUE_SORT_A_COUNTRY_CODE_DESC</option>
			<option value="a.published ASC">COM_JOOMLEAGUE_SORT_A_PUBLISHED_ASC</option>
			<option value="a.published DESC">COM_JOOMLEAGUE_SORT_A_PUBLISHED_DESC</option>
		
			<option value="assignment_count ASC">COM_JOOMLEAGUE_SORT_ASSIGNMENT_COUNT_ASC</option>
			<option value="assignment_count DESC">COM_JOOMLEAGUE_SORT_ASSIGNMENT_COUNT_DESC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="20" onchange="this.form.submit();" />
	</fields>
</form>
