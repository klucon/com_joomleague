<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" label="JSEARCH_FILTER" hint="JSEARCH_FILTER" />
		<field name="published" type="status" label="JOPTION_SELECT_PUBLISHED" onchange="this.form.submit();">
			<option value="">JOPTION_SELECT_PUBLISHED</option>
		</field>
		<field name="project_id" type="sql" label="COM_JOOMLEAGUE_MENU_PROJECTS" query="SELECT id,name FROM #__joomleague_project ORDER BY name" key_field="id" value_field="name" onchange="this.form.submit();">
			<option value="">COM_JOOMLEAGUE_FILTER_ALL_PROJECTS</option>
		</field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" onchange="this.form.submit();" default="a.id DESC">
			<option value="a.name ASC">JGLOBAL_TITLE_ASC</option>
			<option value="a.name DESC">JGLOBAL_TITLE_DESC</option>
			<option value="p.name ASC">COM_JOOMLEAGUE_MENU_PROJECTS</option>
			<option value="a.deadline_minutes ASC">COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_DEADLINE</option>
			<option value="a.points_exact DESC">COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_POINTS_EXACT</option>
			<option value="a.points_tendency DESC">COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_POINTS_TENDENCY</option>
			<option value="a.points_goal_diff DESC">COM_JOOMLEAGUE_PREDICTIONGAME_FIELD_POINTS_GOAL_DIFF</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" />
	</fields>
</form>
