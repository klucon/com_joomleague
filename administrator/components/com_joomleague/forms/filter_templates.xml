<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" label="JSEARCH_FILTER" />
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.template ASC" onchange="this.form.submit();">
			<option value="a.template ASC">COM_JOOMLEAGUE_TEMPLATE_ORDER_TEMPLATE_ASC</option>
			<option value="a.template DESC">COM_JOOMLEAGUE_TEMPLATE_ORDER_TEMPLATE_DESC</option>
			<option value="a.title ASC">COM_JOOMLEAGUE_TEMPLATE_ORDER_TITLE_ASC</option>
			<option value="a.title DESC">COM_JOOMLEAGUE_TEMPLATE_ORDER_TITLE_DESC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" />
	</fields>
</form>
