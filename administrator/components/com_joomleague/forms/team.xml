<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="details" label="COM_JOOMLEAGUE_FIELDSET_DETAILS">
		<field name="name" type="text" label="COM_JOOMLEAGUE_FIELD_NAME_LABEL" description="COM_JOOMLEAGUE_FIELD_TEAM_NAME_DESC" required="true" maxlength="255" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="COM_JOOMLEAGUE_FIELD_ALIAS_DESC" maxlength="255" />
		<field name="middle_name" type="text" label="COM_JOOMLEAGUE_FIELD_MIDDLE_NAME_LABEL" description="COM_JOOMLEAGUE_FIELD_TEAM_MIDDLE_NAME_DESC" maxlength="100" />
		<field name="short_name" type="text" label="COM_JOOMLEAGUE_FIELD_SHORT_NAME_LABEL" description="COM_JOOMLEAGUE_FIELD_TEAM_SHORT_NAME_DESC" maxlength="50" />
		<field name="club_id" type="sql" label="COM_JOOMLEAGUE_FIELD_CLUB_LABEL" description="COM_JOOMLEAGUE_FIELD_TEAM_CLUB_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_club WHERE published = 1 ORDER BY name" key_field="value" value_field="text" default="0">
			<option value="0">COM_JOOMLEAGUE_OPTION_NO_CLUB</option>
		</field>
		<field name="website" type="url" label="COM_JOOMLEAGUE_FIELD_WEBSITE_LABEL" description="COM_JOOMLEAGUE_FIELD_TEAM_WEBSITE_DESC" maxlength="2048" filter="url" />
		<field name="external_code" type="text" label="COM_JOOMLEAGUE_FIELD_EXTERNAL_CODE_LABEL" description="COM_JOOMLEAGUE_FIELD_TEAM_EXTERNAL_CODE_DESC" maxlength="191" />
	</fieldset>
	<fieldset name="media" label="COM_JOOMLEAGUE_FIELDSET_MEDIA">
		<field name="logo" type="media" label="COM_JOOMLEAGUE_FIELD_TEAM_LOGO_LABEL" description="COM_JOOMLEAGUE_FIELD_TEAM_LOGO_DESC" types="images" directory="com_joomleague/teams/logos" />
		<field name="picture" type="media" label="COM_JOOMLEAGUE_FIELD_TEAM_PICTURE_LABEL" description="COM_JOOMLEAGUE_FIELD_TEAM_PICTURE_DESC" types="images" directory="com_joomleague/teams/photos" />
		<field name="media_history" type="subform" label="COM_JOOMLEAGUE_FIELD_LOGO_HISTORY_LABEL" description="COM_JOOMLEAGUE_FIELD_LOGO_HISTORY_DESC" formsource="administrator/components/com_joomleague/forms/organization_media_history.xml" multiple="true" layout="joomla.form.field.subform.repeatable-table" buttons="add" />
	</fieldset>
	<fieldset name="history" label="COM_JOOMLEAGUE_FIELDSET_TEAM_HISTORY">
		<field name="name_history" type="subform" label="COM_JOOMLEAGUE_FIELD_NAME_HISTORY_LABEL" description="COM_JOOMLEAGUE_FIELD_NAME_HISTORY_DESC" formsource="administrator/components/com_joomleague/forms/organization_name_history.xml" multiple="true" layout="joomla.form.field.subform.repeatable-table" buttons="add" />
	</fieldset>
	<fieldset name="description" label="JGLOBAL_DESCRIPTION">
		<field name="description" type="editor" label="JGLOBAL_DESCRIPTION" description="COM_JOOMLEAGUE_FIELD_TEAM_DESCRIPTION_DESC" filter="safehtml" buttons="true" />
	</fieldset>
	<fieldset name="publishing" label="JGLOBAL_FIELDSET_PUBLISHING">
		<field name="published" type="status" label="JSTATUS" description="COM_JOOMLEAGUE_FIELD_PUBLISHED_DESC" default="1" />
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" description="COM_JOOMLEAGUE_FIELD_ORDERING_DESC" default="0" />
		<field name="uuid" type="text" label="COM_JOOMLEAGUE_FIELD_UUID_LABEL" description="COM_JOOMLEAGUE_FIELD_UUID_DESC" readonly="true" />
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" description="JGLOBAL_FIELD_ID_DESC" readonly="true" class="readonly" default="0" />
	</fieldset>
</form>
