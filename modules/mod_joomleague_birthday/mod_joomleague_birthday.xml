<?xml version='1.0' encoding='UTF-8'?>
<extension type="module" client="site" method="upgrade">
	<name>mod_joomleague_birthday</name>
	<author>Ondřej Klučka (https://klucon.cz)</author>
	<authorEmail>info@klucon.cz</authorEmail>
	<authorUrl>https://klucon.cz</authorUrl>
	<creationDate>2026-07</creationDate>
	<copyright>(C) 2026 Ondřej Klučka (https://klucon.cz).</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>6.1.0-alpha-151</version>
	<description>MOD_JOOMLEAGUE_BIRTHDAY_XML_DESCRIPTION</description>
	<namespace path="src">Joomleague\Module\Birthday</namespace>
	<files>
		<folder module="mod_joomleague_birthday">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_joomleague_birthday.ini</language>
		<language tag="de-DE">language/de-DE/mod_joomleague_birthday.ini</language>
		<language tag="en-GB">language/en-GB/mod_joomleague_birthday.sys.ini</language>
		<language tag="de-DE">language/de-DE/mod_joomleague_birthday.sys.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_birthday.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_birthday.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="projects" type="sql" default="" required="true" label="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_PROJECTS_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_PROJECTS_DESCR" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_project ORDER BY name, id" key_field="value" value_field="text" multiple="true" />
				<field name="use_fav" type="radio" default="1" label="MOD_JOOMLEAGUE_BIRTHDAY_USE_FAVORITE_TEAM_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_USE_FAVORITE_TEAM_DESCR">
					<option value="0">MOD_JOOMLEAGUE_BIRTHDAY_NO</option>
					<option value="1">MOD_JOOMLEAGUE_BIRTHDAY_YES</option>
				</field>
				<field name="teams" type="sql" default="" label="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_TEAM_IDS_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_TEAM_IDS_DESCR" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_team ORDER BY name, id" key_field="value" value_field="text" multiple="true" />
				<field name="limit" type="text" default="1" label="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_MAX_BIRTHDAYS_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_MAX_BIRTHDAYS_DESCR" />
				<field name="use_which" type="list" default="0" label="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_PERSON_TYPES_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_PERSON_TYPES_DESCR">
					<option value="0">MOD_JOOMLEAGUE_BIRTHDAY_PERSON_TYPE_PLAYERS_AND_STAFF
					</option>
					<option value="1">MOD_JOOMLEAGUE_BIRTHDAY_PERSON_TYPE_ONLY_PLAYERS
					</option>
					<option value="2">MOD_JOOMLEAGUE_BIRTHDAY_PERSON_TYPE_ONLY_STAFF
					</option>
				</field>
				<field name="sort_order" type="list" default="-" label="MOD_JOOMLEAGUE_BIRTHDAY_SORT_ORDER_SAME_DAY_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_SORT_ORDER_SAME_DAY_DESCR">
					<option value="-">MOD_JOOMLEAGUE_BIRTHDAY_SAME_DAY_SORTING_OLDEST_FIRST
					</option>
					<option value="+">MOD_JOOMLEAGUE_BIRTHDAY_SAME_DAY_SORTING_YOUNGEST_FIRST
					</option>
				</field>
				<field name="maxdays" type="text" default="" label="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_MAX_DAYS_AHEAD_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_MAX_DAYS_AHEAD_DESCR" />
				<field name="Itemid" type="text" default="" label="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_ITEMID_FOR_LINKS_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_SELECT_ITEMID_FOR_LINKS_DESCR" />
				<field name="spacer_9" type="spacer" default="" label="MOD_JOOMLEAGUE_BIRTHDAY_SPACER_LAYOUT_SETTINGS" description="" />
				<field name="name_format" type="list" label="MOD_JOOMLEAGUE_BIRTHDAY_NAME_FORMAT_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_NAME_FORMAT_DESCR">
					<option value="0">MOD_JOOMLEAGUE_NAME_FORMAT_FIRST_LAST</option>
					<option value="1">MOD_JOOMLEAGUE_NAME_FORMAT_LAST_FIRST</option>
					<option value="2">MOD_JOOMLEAGUE_NAME_FORMAT_NICKNAME</option>
				</field>
				<field name="show_player_flag" type="radio" default="1" label="MOD_JOOMLEAGUE_BIRTHDAY_SHOW_PLAYER_FLAG_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_SHOW_PLAYER_FLAG_DESCR">
					<option value="0">MOD_JOOMLEAGUE_BIRTHDAY_NO</option>
					<option value="1">MOD_JOOMLEAGUE_BIRTHDAY_YES</option>
				</field>
				<field name="heading_style" type="text" default="sectiontableheader" label="MOD_JOOMLEAGUE_BIRTHDAY_HEADING_STYLE_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_HEADING_STYLE_DESCR" />
				<field name="show_picture" type="radio" default="0" label="MOD_JOOMLEAGUE_BIRTHDAY_SHOW_PLAYER_PICTURE_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_SHOW_PLAYER_PICTURE_DESCR">
					<option value="0">MOD_JOOMLEAGUE_BIRTHDAY_NO</option>
					<option value="1">MOD_JOOMLEAGUE_BIRTHDAY_YES</option>
				</field>
				<field name="picture_width" type="text" default="120" label="MOD_JOOMLEAGUE_BIRTHDAY_PICTURE_WIDTH_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_PICTURE_WIDTH_DESCR" />
				<field name="spacer_15" type="spacer" default="" label="MOD_JOOMLEAGUE_BIRTHDAY_SPACER_CUSTOMIZE_MESSAGES_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_SPACER_CUSTOMIZE_MESSAGES_DESCR" />
				<field name="time_zone" type="timezone" default="UTC" label="MOD_JOOMLEAGUE_CALENDAR_LABEL_TIMEZONE" description="MOD_JOOMLEAGUE_CALENDAR_DESC_TIMEZONE" />
				<field name="dayformat" type="text" default="d. F Y" label="MOD_JOOMLEAGUE_BIRTHDAY_DATE_FORMAT_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_DATE_FORMAT_DESCR" />
				<field name="birthdayformat" type="text" default="d.m.Y" label="MOD_JOOMLEAGUE_BIRTHDAY_DATE_OF_BIRTH_FORMAT_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_DATE_OF_BIRTH_FORMAT_DESCR" />
				<field name="futuremessage" type="text" default="in %DAYS_TO% days" label="MOD_JOOMLEAGUE_BIRTHDAY_FUTURE_MESSAGE_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_FUTURE_MESSAGE_DESCR" />
				<field name="todaymessage" type="text" default="today" label="MOD_JOOMLEAGUE_BIRTHDAY_TODAY_MESSAGE_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_TODAY_MESSAGE_DESCR" />
				<field name="tomorrowmessage" type="text" default="tomorrow" label="MOD_JOOMLEAGUE_BIRTHDAY_TOMORROW_MESSAGE_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_TOMORROW_MESSAGE_DESCR" />
				<field name="birthdaytext" type="textarea" default="... is becoming %AGE% years old%BR% %WHEN% on %DATE% %BR% (* %DATE_OF_BIRTH%)" cols="25" rows="5" label="MOD_JOOMLEAGUE_BIRTHDAY_MESSAGE_FOR_BIRTHDAY_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_MESSAGE_FOR_BIRTHDAY_DESCR" />
				<field name="not_found_text" type="textarea" default="... no player has a birthday next %DAYS% days!" cols="25" rows="5" label="MOD_JOOMLEAGUE_BIRTHDAY_NO_BIRTHDAY_MESSAGE_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_NO_BIRTHDAY_MESSAGE_DESCR" />
			</fieldset>
			<fieldset name="advanced">
				<field name="moduleclass_sfx" type="text" default="" label="MOD_JOOMLEAGUE_BIRTHDAY_MODULE_CLASS_SUFFIX_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_MODULE_CLASS_SUFFIX_DESCR" />
				<field name="sectiontableentry1" type="text" default="sectiontableentry1" label="MOD_JOOMLEAGUE_BIRTHDAY_PERSON_STYLE_ODD_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_PERSON_STYLE_ODD_DESCR" />
				<field name="sectiontableentry2" type="text" default="sectiontableentry2" label="MOD_JOOMLEAGUE_BIRTHDAY_PERSON_STYLE_EVEN_LABEL" description="MOD_JOOMLEAGUE_BIRTHDAY_PERSON_STYLE_EVEN_DESCR" />
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" />
			</fieldset>
		</fields>
	</config>
</extension>
