<extension type="module" client="site" method="upgrade"><name>mod_joomleague_club</name><author>Ondřej Klučka (https://joomleague.eu)</author><creationDate>2026-08</creationDate><copyright>(C) 2026 Ondřej Klučka.</copyright><license>GNU General Public License version 2 or later; see LICENSE.txt</license><version>6.2.0-dev7</version><description>MOD_JOOMLEAGUE_CLUB_XML_DESCRIPTION</description><namespace path="src">Joomleague\Module\Club</namespace><files><folder module="mod_joomleague_club">services</folder><folder>src</folder><folder>tmpl</folder></files><languages><language tag="en-GB">language/en-GB/mod_joomleague_club.ini</language><language tag="en-GB">language/en-GB/mod_joomleague_club.sys.ini</language><language tag="cs-CZ">language/cs-CZ/mod_joomleague_club.ini</language><language tag="cs-CZ">language/cs-CZ/mod_joomleague_club.sys.ini</language></languages><config><fields name="params"><fieldset name="basic">
<field name="club_id" type="sql" required="true" label="MOD_JOOMLEAGUE_CLUB_CLUB_LABEL" description="MOD_JOOMLEAGUE_CLUB_CLUB_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_club WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text" />
