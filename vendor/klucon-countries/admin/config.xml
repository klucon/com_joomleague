<?xml version="1.0" encoding="utf-8"?>
<config>
 <fieldset name="registry" label="COM_KLUCONCOUNTRIES_CONFIG_REGISTRY">
  <field name="default_view" type="list" label="COM_KLUCONCOUNTRIES_CONFIG_VIEW" default="tree"><option value="tree">COM_KLUCONCOUNTRIES_VIEW_TREE</option><option value="list">COM_KLUCONCOUNTRIES_VIEW_LIST</option></field>
  <field name="list_limit" type="number" min="5" max="200" default="25" label="COM_KLUCONCOUNTRIES_CONFIG_LIMIT"/>
  <field name="upload_enabled" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_KLUCONCOUNTRIES_CONFIG_UPLOAD"><option value="0">JNO</option><option value="1">JYES</option></field>
  <field name="upload_max_kb" type="number" min="16" max="2048" default="1024" label="COM_KLUCONCOUNTRIES_CONFIG_UPLOAD_SIZE"/>
  <field name="import_max_kb" type="number" min="16" max="5120" default="2048" label="COM_KLUCONCOUNTRIES_CONFIG_IMPORT_SIZE"/>
  <field name="import_max_records" type="number" min="1" max="10000" default="1000" label="COM_KLUCONCOUNTRIES_CONFIG_IMPORT_RECORDS"/>
 </fieldset>
 <fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL"><field name="rules" type="rules" component="com_kluconcountries" section="component" label="JCONFIG_PERMISSIONS_LABEL"/></fieldset>
</config>
