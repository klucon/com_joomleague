<?xml version="1.0" encoding="UTF-8"?>
<metadata>
	<layout title="COM_JOOMLEAGUE_CLUBRIVALS_VIEW_DEFAULT_TITLE"><message><![CDATA[COM_JOOMLEAGUE_CLUBRIVALS_VIEW_DEFAULT_DESC]]></message></layout>
	<fields name="request"><fieldset name="request">
		<field name="club_id" type="sql" required="false" label="COM_JOOMLEAGUE_CLUBRIVALS_REQUEST_CLUB_LABEL" description="COM_JOOMLEAGUE_CLUBRIVALS_REQUEST_CLUB_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_club WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="">COM_JOOMLEAGUE_CLUBRIVALS_REQUEST_SITE_CLUB</option></field>
	<field name="team_id" type="sql" filter="integer" label="COM_JOOMLEAGUE_CLUBRIVALS_REQUEST_TEAM" query="SELECT id AS value,name AS text FROM #__joomleague_team WHERE published=1 ORDER BY name,id" key_field="value" value_field="text"><option value="0">COM_JOOMLEAGUE_CLUBRIVALS_ALL_TEAMS</option></field></fieldset></fields>
	<fields name="params"><fieldset name="options" label="JGLOBAL_FIELDSET_DISPLAY_OPTIONS">
		<field name="enable_column_sorting" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_JOOMLEAGUE_CLUBRIVALS_ENABLE_SORTING_LABEL" description="COM_JOOMLEAGUE_CLUBRIVALS_ENABLE_SORTING_DESC"><option value="1">JYES</option><option value="0">JNO</option></field>
		<field name="rival_grouping" type="list" default="team" label="COM_JOOMLEAGUE_CLUBRIVALS_GROUPING"><option value="team">COM_JOOMLEAGUE_CLUBRIVALS_GROUP_TEAMS</option><option value="club">COM_JOOMLEAGUE_CLUBRIVALS_GROUP_CLUBS</option></field>
		<field name="rival_date_format" type="list" default="compact" label="COM_JOOMLEAGUE_CLUBRIVALS_DATE_FORMAT"><option value="compact">COM_JOOMLEAGUE_CLUBRIVALS_DATE_COMPACT</option><option value="iso">COM_JOOMLEAGUE_CLUBRIVALS_DATE_ISO</option><option value="locale">COM_JOOMLEAGUE_CLUBRIVALS_DATE_LOCALE</option></field>
		<field name="show_rival_breakdowns" type="radio" layout="joomla.form.field.radio.switcher" default="1" label="COM_JOOMLEAGUE_CLUBRIVALS_SHOW_BREAKDOWNS"><option value="1">JSHOW</option><option value="0">JHIDE</option></field>
	</fieldset></fields>
</metadata>
