<?xml version='1.0' encoding='UTF-8'?>
<extension type="module" client="site" method="upgrade">
	<name>mod_joomleague_logo</name>
	<author>Ondřej Klučka (https://klucon.cz)</author>
	<authorEmail>info@klucon.cz</authorEmail>
	<creationDate>2026-06</creationDate>
	<copyright>(C) 2026 Ondřej Klučka (https://klucon.cz).</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>0.35.3</version>
	<description>MOD_JOOMLEAGUE_LOGO_XML_DESCRIPTION</description>
	<namespace path="src">Joomleague\Module\Logo</namespace>
	<files>
		<folder module="mod_joomleague_logo">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_joomleague_logo.ini</language>
		<language tag="en-GB">language/en-GB/mod_joomleague_logo.sys.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_logo.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_logo.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic" addfieldpath="/administrator/components/com_joomleague/models/fields">
				<field name="p" type="sql" default="" label="MOD_JOOMLEAGUE_LOGO_PROJECT_ID_LABEL" description="MOD_JOOMLEAGUE_LOGO_PROJECT_ID_LABEL_DESC" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_project ORDER BY name, id" key_field="value" value_field="text" />
				<field name="division_id" type="sql" depends="p" task="projectdivisionsoptions" label="MOD_JOOMLEAGUE_LOGO_DIVISION_ID_LABEL" description="MOD_JOOMLEAGUE_LOGO_DIVISION_ID_LABEL_DESC" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_division ORDER BY name, id" key_field="value" value_field="text" />
				<field name="limit" type="text" default="10" label="MOD_JOOMLEAGUE_LOGO_ROW_LIMIT_LABEL" description="MOD_JOOMLEAGUE_LOGO_ROW_LIMIT_LABEL_DESC" />
				<field name="spacer_4" type="spacer" default="" label="" description="" />
				<field name="show_project_name" type="list" default="0" label="MOD_JOOMLEAGUE_LOGO_SHOW_PROJECT_NAME" description="MOD_JOOMLEAGUE_LOGO_SHOW_PROJECT_NAME_DESC">
					<option value="0">No</option>
					<option value="1">Yes</option>
				</field>
				<field name="nametype" type="list" default="name" label="MOD_JOOMLEAGUE_LOGO_TEAM_NAME_LABEL" description="MOD_JOOMLEAGUE_LOGO_TEAM_NAME_DESC=">
					<option value="short_name">MOD_JOOMLEAGUE_LOGO_TEAM_NAME_SHORT</option>
					<option value="middle_name">MOD_JOOMLEAGUE_LOGO_TEAM_NAME_MEDIUM</option>
					<option value="name">MOD_JOOMLEAGUE_LOGO_TEAM_NAME_FULL</option>
				</field>
				<field name="show_logo" type="list" default="0" label="MOD_JOOMLEAGUE_LOGO_SHOW_LOGO_LABEL" description="MOD_JOOMLEAGUE_LOGO_SHOW_LOGO_LABEL_DESC">
					<option value="0">MOD_JOOMLEAGUE_LOGO_SHOW_SMALL_LOGO</option>
					<option value="1">MOD_JOOMLEAGUE_LOGO_SHOW_MEDIUM_LOGO</option>
					<option value="2">MOD_JOOMLEAGUE_LOGO_SHOW_BIG_LOGO</option>
					<option value="3">MOD_JOOMLEAGUE_LOGO_SHOW_TEAM_LOGO</option>
					<option value="4">MOD_JOOMLEAGUE_LOGO_SHOW_PROJECTTEAM_LOGO</option>
				</field>
				<field name="teamlink" type="list" default="teaminfo" label="MOD_JOOMLEAGUE_LOGO_TEAM_LINK_LABEL" description="MOD_JOOMLEAGUE_LOGO_TEAM_LINK_DESC">
					<option value="">MOD_JOOMLEAGUE_LOGO_LINK_NO_LINK</option>
					<option value="teaminfo">MOD_JOOMLEAGUE_LOGO_LINK_TEAMINFO</option>
					<option value="roster">MOD_JOOMLEAGUE_LOGO_LINK_ROSTER</option>
					<option value="teamplan">MOD_JOOMLEAGUE_LOGO_LINK_TEAMPLAN</option>
					<option value="clubinfo">MOD_JOOMLEAGUE_LOGO_LINK_CLUBINFO</option>
					<option value="teamwww">MOD_JOOMLEAGUE_LOGO_LINK_TEAMWWW</option>
					<option value="clubwww">MOD_JOOMLEAGUE_LOGO_LINK_CLUBWWW</option>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="cache" type="list" default="1" label="MOD_JOOMLEAGUE_LOGO_CACHING_LABEL" description="MOD_JOOMLEAGUE_LOGO_CACHING_DESCR">
					<option value="1">MOD_JOOMLEAGUE_LOGO_CACHING_USE_GLOBAL</option>
					<option value="0">MOD_JOOMLEAGUE_LOGO_CACHING_NO_CACHING</option>
				</field>
				<field name="cache_time" type="text" default="900" label="MOD_JOOMLEAGUE_LOGO_CACHE_TIME_LABEL" description="MOD_JOOMLEAGUE_LOGO_CACHE_TIME_DESCR">
				</field>
				<field name="moduleclass_sfx" type="text" default="" label="MOD_JOOMLEAGUE_LOGO_MODULE_CLASS_SUFFIX_LABEL" description="MOD_JOOMLEAGUE_LOGO_MODULE_CLASS_SUFFIX_DESCR">
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" />
			</fieldset>
		</fields>
	</config>
</extension>