<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" label="JSEARCH_FILTER" />
		<field name="published" type="status" label="JOPTION_SELECT_PUBLISHED" onchange="this.form.submit();" />
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" default="a.ordering ASC" onchange="this.form.submit();">
			<option value="a.ordering ASC">JGRID_HEADING_ORDERING_ASC</option>
			<option value="a.ordering DESC">JGRID_HEADING_ORDERING_DESC</option>
			<option value="pe.lastname ASC">COM_JOOMLEAGUE_PERSON_ASC</option>
			<option value="pe.lastname DESC">COM_JOOMLEAGUE_PERSON_DESC</option>
		</field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" class="js-select-submit-on-change"/>
	</fields>
</form>
