<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
 <name>mod_joomleague_programme_ticker</name><author>Ondřej Klučka (https://joomleague.eu)</author><creationDate>2026-09</creationDate><copyright>(C) 2026 Ondřej Klučka.</copyright><license>GNU General Public License version 2 or later; see LICENSE.txt</license><version>6.2.0-rc2</version><description>MOD_JOOMLEAGUE_PROGRAMME_TICKER_XML_DESCRIPTION</description>
 <namespace path="src">Joomleague\Module\ProgrammeTicker</namespace>
 <files><folder module="mod_joomleague_programme_ticker">services</folder><folder>src</folder><folder>tmpl</folder><folder>media</folder></files>
 <languages><language tag="en-GB">language/en-GB/mod_joomleague_programme_ticker.ini</language><language tag="en-GB">language/en-GB/mod_joomleague_programme_ticker.sys.ini</language></languages>
 <config><fields name="params">
  <fieldset name="basic" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_FIELDSET_SOURCE">
   <field name="sport_type_id" type="sql" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SPORT_LABEL" query="SELECT id AS value, name AS text FROM #__joomleague_sport_type WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_PROGRAMME_TICKER_ALL_SPORTS</option></field>
   <field name="season_id" type="sql" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SEASON_LABEL" query="SELECT id AS value, name AS text FROM #__joomleague_season WHERE published = 1 ORDER BY ordering, id DESC" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_PROGRAMME_TICKER_ALL_SEASONS</option></field>
   <field name="project_id" type="sql" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_PROJECT_LABEL" query="SELECT id AS value, name AS text FROM #__joomleague_project WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_PROGRAMME_TICKER_ALL_PROJECTS</option></field>
   <field name="stage_id" type="sql" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_STAGE_LABEL" query="SELECT stage.id AS value, CONCAT(project.name, ' — ', stage.name) AS text FROM #__joomleague_project_stage AS stage INNER JOIN #__joomleague_project AS project ON project.id = stage.project_id WHERE stage.published = 1 AND project.published = 1 ORDER BY project.name, stage.ordering, stage.id" key_field="value" value_field="text"><option value="0">JALL</option></field>
   <field name="round_id" type="sql" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_ROUND_LABEL" query="SELECT round.id AS value, CONCAT(project.name, ' — ', stage.name, ' — ', round.name) AS text FROM #__joomleague_project_round AS round INNER JOIN #__joomleague_project_stage AS stage ON stage.id = round.stage_id INNER JOIN #__joomleague_project AS project ON project.id = round.project_id WHERE round.published = 1 AND stage.published = 1 AND project.published = 1 ORDER BY project.name, stage.ordering, round.ordering, round.id" key_field="value" value_field="text"><option value="0">JALL</option></field>
   <field name="club_id" type="sql" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_CLUB_LABEL" query="SELECT id AS value, name AS text FROM #__joomleague_club WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_PROGRAMME_TICKER_ALL_CLUBS</option></field>
   <field name="entry_id" type="sql" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_ENTRY_LABEL" query="SELECT entry.id AS value, CONCAT(project.name, ' — ', COALESCE(NULLIF(entry.display_name, ''), team.name, CONCAT(person.first_name, ' ', person.last_name), CONCAT('ID ', entry.id))) AS text FROM #__joomleague_project_entry AS entry INNER JOIN #__joomleague_project AS project ON project.id = entry.project_id LEFT JOIN #__joomleague_team AS team ON team.id = entry.team_id LEFT JOIN #__joomleague_person AS person ON person.id = entry.person_id WHERE entry.published = 1 AND project.published = 1 ORDER BY project.name, text" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_PROGRAMME_TICKER_ALL_ENTRIES</option></field>
   <field name="venue_id" type="sql" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_VENUE_LABEL" query="SELECT id AS value, name AS text FROM #__joomleague_venue WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_PROGRAMME_TICKER_ALL_VENUES</option></field>
  </fieldset>
  <fieldset name="content" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_FIELDSET_CONTENT">
   <field name="status_codes" type="sql" multiple="true" layout="joomla.form.field.list-fancy-select" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_STATUS_FILTER_LABEL" query="SELECT DISTINCT status_code AS value, status_code AS text FROM #__joomleague_project_match WHERE status_code IS NOT NULL AND status_code &lt;&gt; '' ORDER BY status_code" key_field="value" value_field="text" />
   <field name="content_mode" type="list" default="both" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_MODE_LABEL"><option value="both">MOD_JOOMLEAGUE_PROGRAMME_TICKER_MODE_BOTH</option><option value="completed">MOD_JOOMLEAGUE_PROGRAMME_TICKER_MODE_COMPLETED</option><option value="upcoming">MOD_JOOMLEAGUE_PROGRAMME_TICKER_MODE_UPCOMING</option></field>
   <field name="days_before" type="number" default="30" min="0" max="5000" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_DAYS_BEFORE_LABEL"/><field name="days_after" type="number" default="30" min="0" max="5000" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_DAYS_AFTER_LABEL"/>
   <field name="completed_limit" type="number" default="3" min="0" max="100" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_COMPLETED_LIMIT_LABEL"/><field name="upcoming_limit" type="number" default="5" min="0" max="100" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_UPCOMING_LIMIT_LABEL"/>
   <field name="item_limit" type="number" default="8" min="1" max="100" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_ITEM_LIMIT_LABEL"/><field name="participant_limit" type="number" default="4" min="0" max="100" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_PARTICIPANT_LIMIT_LABEL"/>
  </fieldset>
  <fieldset name="motion" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_FIELDSET_MOTION">
   <field name="orientation" type="list" default="horizontal" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_ORIENTATION_LABEL"><option value="horizontal">MOD_JOOMLEAGUE_PROGRAMME_TICKER_ORIENTATION_HORIZONTAL</option><option value="vertical">MOD_JOOMLEAGUE_PROGRAMME_TICKER_ORIENTATION_VERTICAL</option></field>
   <field name="direction" type="list" default="left" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_DIRECTION_LABEL" showon="orientation:horizontal"><option value="left">MOD_JOOMLEAGUE_PROGRAMME_TICKER_DIRECTION_LEFT</option><option value="right">MOD_JOOMLEAGUE_PROGRAMME_TICKER_DIRECTION_RIGHT</option></field>
   <field name="speed" type="number" default="35" min="5" max="300" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SPEED_LABEL" showon="orientation:horizontal"/><field name="pause_on_hover" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_PAUSE_LABEL" layout="joomla.form.field.radio.switcher" showon="orientation:horizontal"><option value="0">JNO</option><option value="1">JYES</option></field><field name="loop" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_LOOP_LABEL" layout="joomla.form.field.radio.switcher" showon="orientation:horizontal"><option value="0">JNO</option><option value="1">JYES</option></field>
  </fieldset>
  <fieldset name="display" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_FIELDSET_DISPLAY">
   <field name="density" type="list" default="standard" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_DENSITY_LABEL"><option value="compact">MOD_JOOMLEAGUE_PROGRAMME_TICKER_DENSITY_COMPACT</option><option value="standard">MOD_JOOMLEAGUE_PROGRAMME_TICKER_DENSITY_STANDARD</option><option value="detailed">MOD_JOOMLEAGUE_PROGRAMME_TICKER_DENSITY_DETAILED</option></field><field name="separator" type="text" default="|" filter="string" maxlength="20" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SEPARATOR_LABEL"/><field name="heading" type="text" filter="string" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_HEADING_LABEL"/>
   <field name="show_sport" type="radio" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_SPORT_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_season" type="radio" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_SEASON_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_project" type="radio" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_PROJECT_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_stage" type="radio" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_STAGE_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_round" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_ROUND_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
   <field name="show_date" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_DATE_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="date_format" type="list" default="medium" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_DATE_FORMAT_LABEL" showon="show_date:1"><option value="short">MOD_JOOMLEAGUE_PROGRAMME_TICKER_FORMAT_SHORT</option><option value="medium">MOD_JOOMLEAGUE_PROGRAMME_TICKER_FORMAT_MEDIUM</option><option value="long">MOD_JOOMLEAGUE_PROGRAMME_TICKER_FORMAT_LONG</option></field><field name="show_time" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_TIME_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="time_format" type="list" default="short" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_TIME_FORMAT_LABEL" showon="show_time:1"><option value="short">MOD_JOOMLEAGUE_PROGRAMME_TICKER_FORMAT_SHORT</option><option value="medium">MOD_JOOMLEAGUE_PROGRAMME_TICKER_FORMAT_MEDIUM</option></field>
   <field name="show_venue" type="radio" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_VENUE_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_status" type="radio" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_STATUS_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_contest_type" type="radio" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_CONTEST_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
   <field name="show_participants" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_PARTICIPANTS_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_images" type="radio" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_IMAGES_LABEL" layout="joomla.form.field.radio.switcher" showon="show_participants:1"><option value="0">JNO</option><option value="1">JYES</option></field><field name="image_size" type="list" default="32" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_IMAGE_SIZE_LABEL" showon="show_images:1"><option value="24">24 px</option><option value="32">32 px</option><option value="40">40 px</option><option value="48">48 px</option></field><field name="image_style" type="list" default="contain" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_IMAGE_STYLE_LABEL" showon="show_images:1"><option value="contain">MOD_JOOMLEAGUE_PROGRAMME_TICKER_IMAGE_CONTAIN</option><option value="cover">MOD_JOOMLEAGUE_PROGRAMME_TICKER_IMAGE_COVER</option><option value="circle">MOD_JOOMLEAGUE_PROGRAMME_TICKER_IMAGE_CIRCLE</option></field>
   <field name="show_result" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_RESULT_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_decider" type="radio" default="0" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_DECIDER_LABEL" layout="joomla.form.field.radio.switcher" showon="show_result:1"><option value="0">JNO</option><option value="1">JYES</option></field><field name="emphasize_winner" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_WINNER_LABEL" layout="joomla.form.field.radio.switcher" showon="show_result:1"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_empty" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_EMPTY_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
  </fieldset>
  <fieldset name="links" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_FIELDSET_LINKS"><field name="show_participant_links" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_PARTICIPANT_LINKS_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_project_link" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_PROJECT_LINK_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_venue_link" type="radio" default="1" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_VENUE_LINK_LABEL" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="template_show_match_detail_button" type="list" default="" label="MOD_JOOMLEAGUE_PROGRAMME_TICKER_SHOW_DETAIL_LABEL"><option value="">MOD_JOOMLEAGUE_PROGRAMME_TICKER_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field></fieldset>
  <fieldset name="advanced"><field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout"/><field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier"/><field name="cache" type="list" default="1" label="COM_MODULES_FIELD_CACHING_LABEL"><option value="1">JGLOBAL_USE_GLOBAL</option><option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option></field><field name="cache_time" type="number" default="300" label="COM_MODULES_FIELD_CACHE_TIME_LABEL"/><field name="cachemode" type="hidden" default="id"/></fieldset>
 </fields></config>
</extension>
