<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field name="search" type="text" label="COM_JOOMLEAGUE_FILTER_SEARCH_LABEL" description="COM_JOOMLEAGUE_FILTER_PROJECTS_SEARCH_DESC" hint="JSEARCH_FILTER" />
		<field name="competition_id" type="sql" label="COM_JOOMLEAGUE_FIELD_COMPETITION_LABEL" description="COM_JOOMLEAGUE_FILTER_PROJECT_COMPETITION_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_competition ORDER BY name" key_field="value" value_field="text" onchange="this.form.submit();"><option value="">COM_JOOMLEAGUE_OPTION_SELECT_COMPETITION</option></field>
		<field name="season_id" type="sql" label="COM_JOOMLEAGUE_FIELD_SEASON_LABEL" description="COM_JOOMLEAGUE_FILTER_PROJECT_SEASON_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_season ORDER BY ordering, name" key_field="value" value_field="text" onchange="this.form.submit();"><option value="">COM_JOOMLEAGUE_OPTION_SELECT_SEASON</option></field>
		<field name="sport_type_id" type="sql" label="COM_JOOMLEAGUE_FIELD_SPORT_TYPE_LABEL" description="COM_JOOMLEAGUE_FILTER_PROJECT_SPORT_TYPE_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_sport_type ORDER BY ordering, name" key_field="value" value_field="text" onchange="this.form.submit();"><option value="">COM_JOOMLEAGUE_OPTION_SELECT_SPORT_TYPE</option></field>
		<field name="project_type" type="list" label="COM_JOOMLEAGUE_FIELD_PROJECT_TYPE_LABEL" description="COM_JOOMLEAGUE_FILTER_PROJECT_TYPE_DESC" onchange="this.form.submit();"><option value="">COM_JOOMLEAGUE_OPTION_SELECT_PROJECT_TYPE</option><option value="league">COM_JOOMLEAGUE_PROJECT_TYPE_LEAGUE</option><option value="cup">COM_JOOMLEAGUE_PROJECT_TYPE_CUP</option><option value="tournament">COM_JOOMLEAGUE_PROJECT_TYPE_TOURNAMENT</option><option value="friendly">COM_JOOMLEAGUE_PROJECT_TYPE_FRIENDLY</option><option value="combined_stage">COM_JOOMLEAGUE_PROJECT_TYPE_COMBINED_STAGE</option><option value="playoff">COM_JOOMLEAGUE_PROJECT_TYPE_PLAYOFF</option><option value="championship">COM_JOOMLEAGUE_PROJECT_TYPE_CHAMPIONSHIP</option><option value="fight_card">COM_JOOMLEAGUE_PROJECT_TYPE_FIGHT_CARD</option><option value="race">COM_JOOMLEAGUE_PROJECT_TYPE_RACE</option><option value="race_series">COM_JOOMLEAGUE_PROJECT_TYPE_RACE_SERIES</option><option value="race_weekend">COM_JOOMLEAGUE_PROJECT_TYPE_RACE_WEEKEND</option></field>
		<field name="lifecycle_state" type="list" label="COM_JOOMLEAGUE_FIELD_LIFECYCLE_STATE_LABEL" description="COM_JOOMLEAGUE_FILTER_PROJECT_LIFECYCLE_DESC" onchange="this.form.submit();"><option value="">COM_JOOMLEAGUE_OPTION_SELECT_LIFECYCLE</option><option value="draft">COM_JOOMLEAGUE_LIFECYCLE_DRAFT</option><option value="active">COM_JOOMLEAGUE_LIFECYCLE_ACTIVE</option><option value="completed">COM_JOOMLEAGUE_LIFECYCLE_COMPLETED</option><option value="archived">COM_JOOMLEAGUE_LIFECYCLE_ARCHIVED</option></field>
		<field name="published" type="status" label="JOPTION_SELECT_PUBLISHED" onchange="this.form.submit();"><option value="">JOPTION_SELECT_PUBLISHED</option></field>
	</fields>
	<fields name="list">
		<field name="fullordering" type="list" label="JGLOBAL_SORT_BY" onchange="this.form.submit();" default="a.id DESC"><option value="">JGLOBAL_SORT_BY</option><option value="a.ordering ASC">JGRID_HEADING_ORDERING_ASC</option><option value="a.ordering DESC">JGRID_HEADING_ORDERING_DESC</option><option value="a.name ASC">JGLOBAL_TITLE_ASC</option><option value="a.name DESC">JGLOBAL_TITLE_DESC</option><option value="a.id ASC">JGRID_HEADING_ID_ASC</option><option value="a.id DESC">JGRID_HEADING_ID_DESC</option></field>
		<field name="limit" type="limitbox" label="JGLOBAL_LIST_LIMIT" default="20" onchange="this.form.submit();" />
	</fields>
</form>
