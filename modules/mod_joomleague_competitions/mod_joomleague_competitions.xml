isation IS NOT NULL AND organisation &lt;&gt; '' ORDER BY organisation" key_field="value" value_field="text"><option value="">JALL</option></field><field name="limit" type="number" default="10" min="1" max="100" label="MOD_JOOMLEAGUE_COMPETITIONS_LIMIT_LABEL" description="MOD_JOOMLEAGUE_COMPETITIONS_LIMIT_DESC"/><field name="show_sport" type="radio" default="1" label="MOD_JOOMLEAGUE_COMPETITIONS_SHOW_SPORT_LABEL" description="MOD_JOOMLEAGUE_COMPETITIONS_SHOW_SPORT_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_season" type="radio" default="1" label="MOD_JOOMLEAGUE_COMPETITIONS_SHOW_SEASON_LABEL" description="MOD_JOOMLEAGUE_COMPETITIONS_SHOW_SEASON_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_organisation" type="radio" default="1" label="MOD_JOOMLEAGUE_COMPETITIONS_SHOW_ORGANISATION_LABEL" description="MOD_JOOMLEAGUE_COMPETITIONS_SHOW_ORGANISATION_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field><field name="show_counts" type="radio" default="1" label="MOD_JOOMLEAGUE_COMPETITIONS_SHOW_COUNTS_LABEL" description="MOD_JOOMLEAGUE_COMPETITIONS_SHOW_COUNTS_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field></fieldset><fieldset name="advanced"><field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout"/><field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier"/><field name="cache" type="list" default="1" label="COM_MODULES_FIELD_CACHING_LABEL"><option value="1">JGLOBAL_USE_GLOBAL</option><option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option></field><field name="cache_time" type="number" default="900" label="COM_MODULES_FIELD_CACHE_TIME_L