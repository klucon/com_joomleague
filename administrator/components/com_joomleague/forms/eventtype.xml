<?xml version='1.0' encoding='UTF-8'?>
<form>
	<fieldset name="details">
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" default="0" />
		<field name="name" type="text" label="COM_JOOMLEAGUE_FIELD_NAME" required="true" description="COM_JOOMLEAGUE_FIELD_NAME_DESCRIPTION" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" />
		<field name="sports_type_id" type="sql" label="COM_JOOMLEAGUE_FIELD_SPORT" query="SELECT id,name FROM #__joomleague_sports_type WHERE published=1 ORDER BY name" key_field="id" value_field="name" required="true" description="COM_JOOMLEAGUE_FIELD_SPORT_DESCRIPTION" translate="true" />
		<field name="parent" type="sql" label="COM_JOOMLEAGUE_FIELD_PARENT" query="SELECT id,name FROM #__joomleague_eventtype ORDER BY name" key_field="id" value_field="name" description="COM_JOOMLEAGUE_FIELD_PARENT_DESCRIPTION">
			<option value="">JGLOBAL_ROOT</option>
		</field>
		<field name="direction" type="list" label="COM_JOOMLEAGUE_EVENTTYPE_FIELD_DIRECTION" description="COM_JOOMLEAGUE_EVENTTYPE_FIELD_DIRECTION_DESCRIPTION">
			<option value="DESC">COM_JOOMLEAGUE_DIRECTION_DESC</option>
			<option value="ASC">COM_JOOMLEAGUE_DIRECTION_ASC</option>
		</field>
		<field name="splitt" type="radio" label="COM_JOOMLEAGUE_EVENTTYPE_FIELD_SPLIT" layout="joomla.form.field.radio.switcher" description="COM_JOOMLEAGUE_EVENTTYPE_FIELD_SPLIT_DESCRIPTION">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="double" type="radio" label="COM_JOOMLEAGUE_EVENTTYPE_FIELD_DOUBLE" layout="joomla.form.field.radio.switcher" description="COM_JOOMLEAGUE_EVENTTYPE_FIELD_DOUBLE_DESCRIPTION">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="suspension" type="number" label="COM_JOOMLEAGUE_EVENTTYPE_FIELD_SUSPENSION" min="0" description="COM_JOOMLEAGUE_EVENTTYPE_FIELD_SUSPENSION_DESCRIPTION" />
	</fieldset>
	<fieldset name="media">
		<field name="icon" type="media" label="COM_JOOMLEAGUE_FIELD_ICON" directory="com_joomleague/database/events" description="COM_JOOMLEAGUE_FIELD_ICON_DESCRIPTION" />
	</fieldset>
	<fieldset name="publishing">
		<field name="published" type="list" label="JSTATUS" default="1">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" />
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_joomleague" section="eventtype" />
	</fieldset>
</form>
