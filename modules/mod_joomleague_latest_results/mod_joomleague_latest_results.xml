<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="site" method="upgrade">
	<name>mod_joomleague_latest_results</name>
	<author>Ondřej Klučka (https://joomleague.eu)</author>
	<creationDate>2026-09</creationDate>
	<copyright>(C) 2026 Ondřej Klučka.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>6.2.0-rc1</version>
	<description>MOD_JOOMLEAGUE_LATEST_RESULTS_XML_DESCRIPTION</description>
	<namespace path="src">Joomleague\Module\LatestResults</namespace>
	<files><folder module="mod_joomleague_latest_results">services</folder><folder>src</folder><folder>tmpl</folder></files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_joomleague_latest_results.ini</language><language tag="en-GB">language/en-GB/mod_joomleague_latest_results.sys.ini</language>
		<language tag="cs-CZ">language/cs-CZ/mod_joomleague_latest_results.ini</language><language tag="cs-CZ">language/cs-CZ/mod_joomleague_latest_results.sys.ini</language>
	</languages>
	<config><fields name="params">
		<fieldset name="basic" label="MOD_JOOMLEAGUE_LATEST_RESULTS_FIELDSET_SOURCE">
			<field name="sport_type_id" type="sql" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SPORT_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SPORT_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_sport_type WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_LATEST_RESULTS_ALL_SPORTS</option></field>
			<field name="season_id" type="sql" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SEASON_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SEASON_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_season WHERE published = 1 ORDER BY ordering, id DESC" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_LATEST_RESULTS_ALL_SEASONS</option></field>
			<field name="project_id" type="sql" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_PROJECT_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_PROJECT_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_project WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_LATEST_RESULTS_ALL_PROJECTS</option></field>
			<field name="stage_id" type="sql" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_STAGE_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_STAGE_DESC" query="SELECT stage.id AS value, CONCAT(project.name, ' — ', stage.name) AS text FROM #__joomleague_project_stage AS stage INNER JOIN #__joomleague_project AS project ON project.id = stage.project_id WHERE stage.published = 1 AND project.published = 1 ORDER BY project.name, stage.ordering, stage.id" key_field="value" value_field="text"><option value="0">JALL</option></field>
			<field name="round_id" type="sql" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_ROUND_FILTER_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_ROUND_FILTER_DESC" query="SELECT round.id AS value, CONCAT(project.name, ' — ', stage.name, ' — ', round.name) AS text FROM #__joomleague_project_round AS round INNER JOIN #__joomleague_project_stage AS stage ON stage.id = round.stage_id INNER JOIN #__joomleague_project AS project ON project.id = round.project_id WHERE round.published = 1 AND stage.published = 1 AND project.published = 1 ORDER BY project.name, stage.ordering, round.ordering, round.id" key_field="value" value_field="text"><option value="0">JALL</option></field>
			<field name="club_id" type="sql" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_CLUB_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_CLUB_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_club WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_LATEST_RESULTS_ALL_CLUBS</option></field>
			<field name="entry_id" type="sql" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_ENTRY_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_ENTRY_DESC" query="SELECT entry.id AS value, CONCAT(project.name, ' — ', COALESCE(NULLIF(entry.display_name, ''), team.name, CONCAT(person.first_name, ' ', person.last_name), CONCAT('ID ', entry.id))) AS text FROM #__joomleague_project_entry AS entry INNER JOIN #__joomleague_project AS project ON project.id = entry.project_id LEFT JOIN #__joomleague_team AS team ON team.id = entry.team_id LEFT JOIN #__joomleague_person AS person ON person.id = entry.person_id WHERE entry.published = 1 AND project.published = 1 ORDER BY project.name, text" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_LATEST_RESULTS_ALL_ENTRIES</option></field>
			<field name="venue_id" type="sql" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_VENUE_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_VENUE_DESC" query="SELECT id AS value, name AS text FROM #__joomleague_venue WHERE published = 1 ORDER BY name, id" key_field="value" value_field="text"><option value="0">MOD_JOOMLEAGUE_LATEST_RESULTS_ALL_VENUES</option></field>
		</fieldset>
		<fieldset name="filters" label="MOD_JOOMLEAGUE_LATEST_RESULTS_FIELDSET_FILTERS">
			<field name="status_codes" type="sql" multiple="true" layout="joomla.form.field.list-fancy-select" label="MOD_JOOMLEAGUE_LATEST_RESULTS_STATUS_FILTER_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_STATUS_FILTER_DESC" query="SELECT DISTINCT status_code AS value, status_code AS text FROM #__joomleague_project_match WHERE status_code IS NOT NULL AND status_code &lt;&gt; '' ORDER BY status_code" key_field="value" value_field="text" />
			<field name="days_before" type="number" default="365" min="1" max="5000" label="MOD_JOOMLEAGUE_LATEST_RESULTS_DAYS_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_DAYS_DESC"/>
			<field name="limit" type="number" default="5" min="1" max="100" label="MOD_JOOMLEAGUE_LATEST_RESULTS_LIMIT_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_LIMIT_DESC"/>
			<field name="participant_limit" type="number" default="4" min="0" max="100" label="MOD_JOOMLEAGUE_LATEST_RESULTS_PARTICIPANT_LIMIT_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_PARTICIPANT_LIMIT_DESC"/>
			<field name="order" type="list" default="newest" label="MOD_JOOMLEAGUE_LATEST_RESULTS_ORDER_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_ORDER_DESC"><option value="newest">MOD_JOOMLEAGUE_LATEST_RESULTS_ORDER_NEWEST</option><option value="oldest">MOD_JOOMLEAGUE_LATEST_RESULTS_ORDER_OLDEST</option></field>
		</fieldset>
		<fieldset name="display" label="MOD_JOOMLEAGUE_LATEST_RESULTS_FIELDSET_DISPLAY">
			<field name="orientation" type="list" default="vertical" label="MOD_JOOMLEAGUE_LATEST_RESULTS_ORIENTATION_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_ORIENTATION_DESC"><option value="vertical">MOD_JOOMLEAGUE_LATEST_RESULTS_ORIENTATION_VERTICAL</option><option value="horizontal">MOD_JOOMLEAGUE_LATEST_RESULTS_ORIENTATION_HORIZONTAL</option></field>
			<field name="density" type="list" default="standard" label="MOD_JOOMLEAGUE_LATEST_RESULTS_DENSITY_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_DENSITY_DESC"><option value="compact">MOD_JOOMLEAGUE_LATEST_RESULTS_DENSITY_COMPACT</option><option value="standard">MOD_JOOMLEAGUE_LATEST_RESULTS_DENSITY_STANDARD</option><option value="detailed">MOD_JOOMLEAGUE_LATEST_RESULTS_DENSITY_DETAILED</option></field>
			<field name="group_by" type="list" default="none" label="MOD_JOOMLEAGUE_LATEST_RESULTS_GROUP_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_GROUP_DESC"><option value="none">JNONE</option><option value="date">MOD_JOOMLEAGUE_LATEST_RESULTS_GROUP_DATE</option><option value="project">MOD_JOOMLEAGUE_LATEST_RESULTS_GROUP_PROJECT</option><option value="round">MOD_JOOMLEAGUE_LATEST_RESULTS_GROUP_ROUND</option></field>
			<field name="heading" type="text" filter="string" label="MOD_JOOMLEAGUE_LATEST_RESULTS_HEADING_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_HEADING_DESC" />
			<field name="show_sport" type="radio" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_SPORT_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_SPORT_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_season" type="radio" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_SEASON_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_SEASON_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_project" type="radio" default="1" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_PROJECT_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_PROJECT_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_stage" type="radio" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_STAGE_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_STAGE_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_round" type="radio" default="1" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_ROUND_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_ROUND_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_date" type="radio" default="1" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_DATE_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_DATE_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="date_format" type="list" default="medium" label="MOD_JOOMLEAGUE_LATEST_RESULTS_DATE_FORMAT_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_DATE_FORMAT_DESC" showon="show_date:1"><option value="short">MOD_JOOMLEAGUE_LATEST_RESULTS_DATE_SHORT</option><option value="medium">MOD_JOOMLEAGUE_LATEST_RESULTS_DATE_MEDIUM</option><option value="long">MOD_JOOMLEAGUE_LATEST_RESULTS_DATE_LONG</option></field>
			<field name="show_time" type="radio" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_TIME_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_TIME_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="time_format" type="list" default="short" label="MOD_JOOMLEAGUE_LATEST_RESULTS_TIME_FORMAT_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_TIME_FORMAT_DESC" showon="show_time:1"><option value="short">MOD_JOOMLEAGUE_LATEST_RESULTS_TIME_SHORT</option><option value="medium">MOD_JOOMLEAGUE_LATEST_RESULTS_TIME_MEDIUM</option></field>
			<field name="show_venue" type="radio" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_VENUE_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_VENUE_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_status" type="radio" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_STATUS_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_STATUS_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_contest_type" type="radio" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_CONTEST_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_CONTEST_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_images" type="radio" default="0" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_IMAGES_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_IMAGES_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="image_size" type="list" default="40" label="MOD_JOOMLEAGUE_LATEST_RESULTS_IMAGE_SIZE_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_IMAGE_SIZE_DESC" showon="show_images:1"><option value="32">32 px</option><option value="40">40 px</option><option value="48">48 px</option><option value="64">64 px</option></field>
			<field name="show_scores" type="radio" default="1" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_SCORES_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_SCORES_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_decider" type="radio" default="1" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_DECIDER_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_DECIDER_DESC" layout="joomla.form.field.radio.switcher" showon="show_scores:1"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="emphasize_winner" type="radio" default="1" label="MOD_JOOMLEAGUE_LATEST_RESULTS_WINNER_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_WINNER_DESC" layout="joomla.form.field.radio.switcher" showon="show_scores:1"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_participant_links" type="radio" default="1" label="MOD_JOOMLEAGUE_LATEST_RESULTS_PARTICIPANT_LINKS_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_PARTICIPANT_LINKS_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_project_link" type="radio" default="1" label="MOD_JOOMLEAGUE_LATEST_RESULTS_PROJECT_LINK_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_PROJECT_LINK_DESC" layout="joomla.form.field.radio.switcher" showon="show_project:1"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_venue_link" type="radio" default="1" label="MOD_JOOMLEAGUE_LATEST_RESULTS_VENUE_LINK_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_VENUE_LINK_DESC" layout="joomla.form.field.radio.switcher" showon="show_venue:1"><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="template_show_match_detail_button" type="list" default="" label="MOD_JOOMLEAGUE_LATEST_RESULTS_DETAIL_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_DETAIL_DESC"><option value="">MOD_JOOMLEAGUE_LATEST_RESULTS_INHERIT</option><option value="0">JNO</option><option value="1">JYES</option></field>
			<field name="show_empty" type="radio" default="1" label="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_EMPTY_LABEL" description="MOD_JOOMLEAGUE_LATEST_RESULTS_SHOW_EMPTY_DESC" layout="joomla.form.field.radio.switcher"><option value="0">JNO</option><option value="1">JYES</option></field>
		</fieldset>
		<fieldset name="advanced">
			<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" class="form-select" validate="moduleLayout"/><field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" validate="CssIdentifier"/><field name="cache" type="list" default="1" label="COM_MODULES_FIELD_CACHING_LABEL"><option value="1">JGLOBAL_USE_GLOBAL</option><option value="0">COM_MODULES_FIELD_VALUE_NOCACHING</option></field><field name="cache_time" type="number" default="900" label="COM_MODULES_FIELD_CACHE_TIME_LABEL"/><field name="cachemode" type="hidden" default="id"/>
		</fieldset>
	</fields></config>
</extension>
