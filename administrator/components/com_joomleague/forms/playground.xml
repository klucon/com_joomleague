<?xml version='1.0' encoding='UTF-8'?>
<form>
	<fieldset name="details" addfieldprefix="Joomleague\Component\Joomleague\Administrator\Field">
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" class="readonly" readonly="true" default="0" />
		<field name="name" type="text" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_NAME_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_NAME_DESCRIPTION" required="true" maxlength="75" />
		<field name="short_name" type="text" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_SHORT_NAME_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_SHORT_NAME_DESCRIPTION" required="true" maxlength="15" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" maxlength="75" />
		<field name="address" type="textarea" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_ADDRESS_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_ADDRESS_DESCRIPTION" rows="2" maxlength="100" />
		<field name="zipcode" type="text" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_ZIPCODE_LABEL" maxlength="10" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_ZIPCODE_LABEL_DESCRIPTION" />
		<field name="city" type="text" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_CITY_LABEL" maxlength="64" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_CITY_LABEL_DESCRIPTION" />
		<field name="country" type="country" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_COUNTRY_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_COUNTRY_DESCRIPTION" />
		<field name="geocode" type="geocode" label="COM_JOOMLEAGUE_FIELD_GEOCODE_LABEL" source_fields="address,zipcode,city" lat_field="latitude" lng_field="longitude" />
		<field name="latitude" type="text" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_LATITUDE_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_LATITUDE_DESCRIPTION" filter="float" />
		<field name="longitude" type="text" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_LONGITUDE_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_LONGITUDE_DESCRIPTION" filter="float" />
		<field name="max_visitors" type="number" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_CAPACITY_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_CAPACITY_DESCRIPTION" min="0" />
		<field name="website" type="url" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_WEBSITE_LABEL" relative="true" maxlength="250" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_WEBSITE_LABEL_DESCRIPTION" />
		<field name="club_id" type="sql" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_CLUB_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_CLUB_DESCRIPTION" query="SELECT id, name FROM #__joomleague_club ORDER BY name" key_field="id" value_field="name">
			<option value="">COM_JOOMLEAGUE_PLAYGROUND_SELECT_CLUB</option>
		</field>
		<field name="picture" type="media" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_PICTURE_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_PICTURE_DESCRIPTION" directory="com_joomleague/playgrounds" preview="tooltip" />
		<field name="notes" type="textarea" rows="8" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_NOTES_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_NOTES_DESCRIPTION" filter="safehtml" />
		<field name="extended" type="textarea" label="COM_JOOMLEAGUE_PLAYGROUND_FIELD_EXTENDED_LABEL" description="COM_JOOMLEAGUE_PLAYGROUND_FIELD_EXTENDED_DESCRIPTION" rows="5" filter="safehtml" />
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" default="0" min="0" />
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_joomleague" section="playground" />
	</fieldset>
</form>
