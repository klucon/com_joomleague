<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="details">
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" class="readonly" readonly="true" default="0" />
		<field name="name" type="text" label="COM_JOOMLEAGUE_SEASON_FIELD_NAME_LABEL" description="COM_JOOMLEAGUE_SEASON_FIELD_NAME_DESCRIPTION" required="true" maxlength="75" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" maxlength="75" />
		<field name="extended" type="textarea" label="COM_JOOMLEAGUE_SEASON_FIELD_EXTENDED_LABEL" description="COM_JOOMLEAGUE_SEASON_FIELD_EXTENDED_DESCRIPTION" rows="6" filter="raw" />
		<field name="published" type="list" label="JSTATUS" default="1" validate="options" class="form-select-color-state">
			<option value="1">JPUBLISHED</option><option value="0">JUNPUBLISHED</option><option value="2">JARCHIVED</option><option value="-2">JTRASHED</option>
		</field>
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" default="0" min="0" />
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_joomleague" section="season" />
	</fieldset>
</form>
