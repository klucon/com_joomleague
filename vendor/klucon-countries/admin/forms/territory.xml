<?xml version="1.0" encoding="utf-8"?>
<form>
 <fieldset name="details" label="COM_KLUCONCOUNTRIES_TAB_DETAILS">
  <field name="name_en" type="text" label="COM_KLUCONCOUNTRIES_NAME_EN" maxlength="190" required="true" filter="string"/>
  <field name="kind" type="list" label="COM_KLUCONCOUNTRIES_TYPE" required="true"/>
  <field name="state" type="list" label="JSTATUS" default="0"><option value="1">JPUBLISHED</option><option value="0">JUNPUBLISHED</option><option value="-2">JTRASHED</option></field>
  <field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" default="0" min="-1000000" max="1000000"/>
  <field name="parent_uuid" type="list" layout="joomla.form.field.list-fancy-select" label="COM_KLUCONCOUNTRIES_PARENT" description="COM_KLUCONCOUNTRIES_PARENT_DESC"><option value="">COM_KLUCONCOUNTRIES_NO_PARENT</option></field>
  <field name="continents" type="list" multiple="true" layout="joomla.form.field.list-fancy-select" label="COM_KLUCONCOUNTRIES_CONTINENTS" description="COM_KLUCONCOUNTRIES_CONTINENTS_DESC"/>
  <field name="valid_from" type="calendar" format="%Y-%m-%d" filter="string" label="COM_KLUCONCOUNTRIES_VALID_FROM"/>
  <field name="valid_to" type="calendar" format="%Y-%m-%d" filter="string" label="COM_KLUCONCOUNTRIES_VALID_TO" description="COM_KLUCONCOUNTRIES_VALID_TO_DESC"/>
 </fieldset>
 <fields name="information"><fieldset name="information" label="COM_KLUCONCOUNTRIES_TAB_INFORMATION">
  <field name="overview" type="textarea" label="COM_KLUCONCOUNTRIES_INFO_OVERVIEW" rows="3" maxlength="4000" filter="raw"/>
  <field name="location" type="textarea" label="COM_KLUCONCOUNTRIES_INFO_LOCATION" rows="2" maxlength="4000" filter="raw"/>
  <field name="boundaries" type="textarea" label="COM_KLUCONCOUNTRIES_INFO_BOUNDARIES" rows="3" maxlength="4000" filter="raw"/>
  <field name="oceans" type="textarea" label="COM_KLUCONCOUNTRIES_INFO_OCEANS" rows="2" maxlength="4000" filter="raw"/>
  <field name="terrain" type="textarea" label="COM_KLUCONCOUNTRIES_INFO_TERRAIN" rows="3" maxlength="4000" filter="raw"/>
  <field name="climate" type="textarea" label="COM_KLUCONCOUNTRIES_INFO_CLIMATE" rows="3" maxlength="4000" filter="raw"/>
  <field name="classification" type="textarea" label="COM_KLUCONCOUNTRIES_INFO_CLASSIFICATION" rows="3" maxlength="4000" filter="raw"/>
  <field name="registry_note" type="textarea" label="COM_KLUCONCOUNTRIES_INFO_REGISTRY_NOTE" rows="3" maxlength="4000" filter="raw"/>
 </fieldset></fields>
 <fieldset name="identifiers" label="COM_KLUCONCOUNTRIES_TAB_IDENTIFIERS">
  <field name="identifiers" type="subform" multiple="true" layout="joomla.form.field.subform.repeatable-table" formsource="administrator/components/com_kluconcountries/forms/identifier.xml" label="COM_KLUCONCOUNTRIES_CODES" max="30"/>
 </fieldset>
 <fieldset name="artwork" label="COM_KLUCONCOUNTRIES_TAB_ARTWORK">
  <field name="flag_mode" type="list" label="COM_KLUCONCOUNTRIES_FLAG_MODE" default="source"><option value="source">COM_KLUCONCOUNTRIES_SOURCE_DEFAULT</option><option value="custom">COM_KLUCONCOUNTRIES_CUSTOM_FLAG</option><option value="none">COM_KLUCONCOUNTRIES_NO_FLAG</option></field>
  <field name="flag" type="list" layout="joomla.form.field.list-fancy-select" label="COM_KLUCONCOUNTRIES_FLAG"><option value="">COM_KLUCONCOUNTRIES_SELECT_FLAG</option></field>
  <field name="flag_file" type="file" label="COM_KLUCONCOUNTRIES_UPLOAD_FLAG" description="COM_KLUCONCOUNTRIES_UPLOAD_DESC" accept=".svg,.png,.jpg,.jpeg,.webp"/>
 </fieldset>
</form>
