<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="details" label="COM_JOOMLEAGUE_FIELDSET_DETAILS" addfieldprefix="Joomleague\Component\Joomleague\Administrator\Field">
		<field name="project_id" type="hidden" filter="integer" />
		<field name="name" type="text" label="COM_JOOMLEAGUE_FIELD_NAME_LABEL" description="COM_JOOMLEAGUE_FIELD_STAGE_NAME_DESC" required="true" maxlength="255" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="COM_JOOMLEAGUE_FIELD_STAGE_ALIAS_DESC" maxlength="255" />
		<field name="code" type="hidden" filter="cmd" />
		<field name="stage_type" type="text" label="COM_JOOMLEAGUE_FIELD_STAGE_TYPE_LABEL" description="COM_JOOMLEAGUE_FIELD_STAGE_TYPE_DESC" required="true" maxlength="100" filter="cmd" />
		<field name="sequence_number" type="number" label="COM_JOOMLEAGUE_FIELD_SEQUENCE_NUMBER_LABEL" description="COM_JOOMLEAGUE_FIELD_SEQUENCE_NUMBER_DESC" min="1" filter="integer" />
		<field name="parent_id" type="stageparent" label="COM_JOOMLEAGUE_FIELD_PARENT_STAGE_LABEL" description="COM_JOOMLEAGUE_FIELD_PARENT_STAGE_DESC" filter="integer" />
		<field name="start_date" type="calendar" label="COM_JOOMLEAGUE_FIELD_START_DATE_LABEL" description="COM_JOOMLEAGUE_FIELD_STAGE_START_DATE_DESC" format="%Y-%m-%d" filter="string" showtime="false" todaybutton="true" filltable="false" />
		<field name="end_date" type="calendar" label="COM_JOOMLEAGUE_FIELD_END_DATE_LABEL" description="COM_JOOMLEAGUE_FIELD_STAGE_END_DATE_DESC" format="%Y-%m-%d" filter="string" showtime="false" todaybutton="true" filltable="false" />
	</fieldset>
	<fieldset name="description" label="COM_JOOMLEAGUE_FIELDSET_DESCRIPTION">
		<field name="description" type="editor" label="COM_JOOMLEAGUE_FIELD_DESCRIPTION_LABEL" description="COM_JOOMLEAGUE_FIELD_STAGE_DESCRIPTION_DESC" filter="safehtml" buttons="true" />
	</fieldset>
	<fieldset name="publishing" label="JGLOBAL_FIELDSET_PUBLISHING">
		<field name="published" type="status" label="JSTATUS" description="COM_JOOMLEAGUE_FIELD_PUBLISHED_DESC" default="0" />
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" description="COM_JOOMLEAGUE_FIELD_ORDERING_DESC" default="0" />
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" description="JGLOBAL_FIELD_ID_DESC" readonly="true" class="readonly" default="0" />
	</fieldset>
</form>
