<?xml version="1.0" encoding="utf-8"?>
<form>
	<fieldset name="details" label="COM_JOOMLEAGUE_FIELDSET_DETAILS">
		<field name="name" type="text" label="COM_JOOMLEAGUE_FIELD_NAME_LABEL" description="COM_JOOMLEAGUE_FIELD_CLUB_NAME_DESC" required="true" maxlength="255" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="COM_JOOMLEAGUE_FIELD_ALIAS_DESC" maxlength="255" />
		<field name="short_name" type="text" label="COM_JOOMLEAGUE_FIELD_SHORT_NAME_LABEL" description="COM_JOOMLEAGUE_FIELD_CLUB_SHORT_NAME_DESC" maxlength="100" />
		<field name="country_code" type="text" label="COM_JOOMLEAGUE_FIELD_COUNTRY_CODE_LABEL" description="COM_JOOMLEAGUE_FIELD_CLUB_COUNTRY_CODE_DESC" maxlength="8" size="8" filter="cmd" />
		<field name="website" type="url" label="COM_JOOMLEAGUE_FIELD_WEBSITE_LABEL" description="COM_JOOMLEAGUE_FIELD_CLUB_WEBSITE_DESC" maxlength="2048" filter="url" />
		<field name="external_code" type="text" label="COM_JOOMLEAGUE_FIELD_EXTERNAL_CODE_LABEL" description="COM_JOOMLEAGUE_FIELD_CLUB_EXTERNAL_CODE_DESC" maxlength="191" />
	</fieldset>
	<fieldset name="media" label="COM_JOOMLEAGUE_FIELDSET_MEDIA">
		<field name="logo" type="media" label="COM_JOOMLEAGUE_FIELD_CLUB_LOGO_LABEL" description="COM_JOOMLEAGUE_FIELD_CLUB_LOGO_DESC" types="images" directory="com_joomleague/clubs" />
		<field name="media_history" type="subform" label="COM_JOOMLEAGUE_FIELD_LOGO_HISTORY_LABEL" description="COM_JOOMLEAGUE_FIELD_LOGO_HISTORY_DESC" formsource="administrator/components/com_joomleague/forms/organization_media_history.xml" multiple="true" layout="joomla.form.field.subform.repeatable-table" buttons="add" />
	</fieldset>
	<fieldset name="history" label="COM_JOOMLEAGUE_FIELDSET_CLUB_HISTORY">
		<field name="founded_date" type="calendar" label="COM_JOOMLEAGUE_FIELD_FOUNDED_DATE_LABEL" description="COM_JOOMLEAGUE_FIELD_FOUNDED_DATE_DESC" format="%Y-%m-%d" filter="user_utc" showtime="false" todaybutton="true" translateformat="true" />
		<field name="dissolved_date" type="calendar" label="COM_JOOMLEAGUE_FIELD_DISSOLVED_DATE_LABEL" description="COM_JOOMLEAGUE_FIELD_DISSOLVED_DATE_DESC" format="%Y-%m-%d" filter="user_utc" showtime="false" todaybutton="true" translateformat="true" />
		<field name="name_history" type="subform" label="COM_JOOMLEAGUE_FIELD_NAME_HISTORY_LABEL" description="COM_JOOMLEAGUE_FIELD_NAME_HISTORY_DESC" formsource="administrator/components/com_joomleague/forms/organization_name_history.xml" multiple="true" layout="joomla.form.field.subform.repeatable-table" buttons="add" />
	</fieldset>
	<fieldset name="related" label="COM_JOOMLEAGUE_FIELDSET_CLUB_RELATED">
		<field name="create_team" type="radio" layout="joomla.form.field.radio.switcher" label="COM_JOOMLEAGUE_FIELD_CREATE_TEAM_LABEL" description="COM_JOOMLEAGUE_FIELD_CREATE_TEAM_DESC" default="0" filter="integer"><option value="0">JNO</option><option value="1">JYES</option></field>
		<field name="create_venue" type="radio" layout="joomla.form.field.radio.switcher" label="COM_JOOMLEAGUE_FIELD_CREATE_VENUE_LABEL" description="COM_JOOMLEAGUE_FIELD_CREATE_VENUE_DESC" default="0" filter="integer"><option value="0">JNO</option><option value="1">JYES</option></field>
	</fieldset>
	<fieldset name="description" label="JGLOBAL_DESCRIPTION">
		<field name="description" type="editor" label="JGLOBAL_DESCRIPTION" description="COM_JOOMLEAGUE_FIELD_CLUB_DESCRIPTION_DESC" filter="safehtml" buttons="true" />
	</fieldset>
	<fieldset name="publishing" label="JGLOBAL_FIELDSET_PUBLISHING">
		<field name="published" type="status" label="JSTATUS" description="COM_JOOMLEAGUE_FIELD_PUBLISHED_DESC" default="1" />
		<field name="access" type="accesslevel" label="JFIELD_ACCESS_LABEL" description="JFIELD_ACCESS_DESC" default="1" filter="uint" />
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" description="COM_JOOMLEAGUE_FIELD_ORDERING_DESC" default="0" />
		<field name="uuid" type="text" label="COM_JOOMLEAGUE_FIELD_UUID_LABEL" description="COM_JOOMLEAGUE_FIELD_UUID_DESC" readonly="true" />
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" description="JGLOBAL_FIELD_ID_DESC" readonly="true" class="readonly" default="0" />
	</fieldset>
</form>
