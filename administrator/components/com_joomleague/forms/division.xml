<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="details">
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" default="0" />
		<field name="project_id" type="sql" label="COM_JOOMLEAGUE_PROJECT" description="COM_JOOMLEAGUE_DIVISION_FIELD_PROJECT_DESCRIPTION" query="SELECT id,name FROM #__joomleague_project ORDER BY name" key_field="id" value_field="name" required="true" />
		<field name="name" type="text" label="COM_JOOMLEAGUE_FIELD_NAME" description="COM_JOOMLEAGUE_DIVISION_FIELD_NAME_DESCRIPTION" required="true" maxlength="75" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" maxlength="75" />
		<field name="shortname" type="text" label="COM_JOOMLEAGUE_DIVISION_FIELD_SHORTNAME" description="COM_JOOMLEAGUE_DIVISION_FIELD_SHORTNAME_DESCRIPTION" maxlength="10" />
		<field name="parent_id" type="sql" label="COM_JOOMLEAGUE_FIELD_PARENT" description="COM_JOOMLEAGUE_DIVISION_FIELD_PARENT_DESCRIPTION" query="SELECT id,name FROM #__joomleague_division ORDER BY ordering,name" key_field="id" value_field="name">
			<option value="">JNONE</option>
		</field>
		<field name="notes" type="textarea" label="COM_JOOMLEAGUE_DIVISION_FIELD_NOTES" description="COM_JOOMLEAGUE_DIVISION_FIELD_NOTES_DESCRIPTION" rows="5" filter="safehtml" />
	</fieldset>
	<fieldset name="media" label="COM_JOOMLEAGUE_FIELDSET_MEDIA">
		<field name="picture" type="media" label="COM_JOOMLEAGUE_FIELD_IMAGE" description="COM_JOOMLEAGUE_FIELD_IMAGE_DESCRIPTION" directory="com_joomleague/divisions" preview="tooltip" />
	</fieldset>
	<fieldset name="publishing">
		<field name="published" type="list" label="JSTATUS" default="1">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" default="0" />
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_joomleague" section="division" />
	</fieldset>
</form>
