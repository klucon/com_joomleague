<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="details">
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" default="0" />
		<field name="project_id" type="hidden" required="true" />
		<field name="template" type="text" label="COM_JOOMLEAGUE_TEMPLATE_FIELD_TEMPLATE" required="true" maxlength="64" description="COM_JOOMLEAGUE_TEMPLATE_FIELD_TEMPLATE_DESC" />
		<field name="func" type="text" label="COM_JOOMLEAGUE_TEMPLATE_FIELD_FUNCTION" maxlength="64" description="COM_JOOMLEAGUE_TEMPLATE_FIELD_FUNCTION_DESC" />
		<field name="title" type="text" label="COM_JOOMLEAGUE_TEMPLATE_FIELD_TITLE" required="true" maxlength="255" description="COM_JOOMLEAGUE_TEMPLATE_FIELD_TITLE_DESC" />
		<field name="params" type="textarea" label="COM_JOOMLEAGUE_TEMPLATE_FIELD_PARAMS" rows="18" cols="80" required="true" filter="raw" description="COM_JOOMLEAGUE_TEMPLATE_FIELD_PARAMS_DESC" />
	</fieldset>
	<fieldset name="publishing">
		<field name="published" type="list" label="JSTATUS" default="1">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>
	</fieldset>
</form>
