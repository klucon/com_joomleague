<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fieldset name="details">
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" default="0" />
		<field name="project_id" type="sql" label="COM_JOOMLEAGUE_MENU_PROJECTS" required="true" query="SELECT id AS value, name AS text FROM #__joomleague_project ORDER BY id DESC" key_field="value" value_field="text" />
		<field name="division_id" type="sql" label="COM_JOOMLEAGUE_PROJECT_DIVISIONS" query="SELECT 0 AS value, '- ' AS text UNION SELECT id AS value, name AS text FROM #__joomleague_division ORDER BY text" key_field="value" value_field="text" />
		<field name="name" type="text" label="COM_JOOMLEAGUE_FIELD_NAME" required="true" maxlength="128" />
		<field name="tree_i" type="number" label="COM_JOOMLEAGUE_TREETO_FIELD_DEPTH" min="1" max="8" default="3" description="COM_JOOMLEAGUE_TREETO_FIELD_DEPTH_DESC" />
		<field name="global_bestof" type="number" label="COM_JOOMLEAGUE_TREETO_FIELD_BESTOF" min="1" default="1" />
		<field name="global_matchday" type="number" label="COM_JOOMLEAGUE_TREETO_FIELD_MATCHDAY" min="0" default="0" />
	</fieldset>
	<fieldset name="flags" label="COM_JOOMLEAGUE_TREETO_FIELDSET_FLAGS">
		<field name="global_known" type="radio" label="COM_JOOMLEAGUE_TREETO_FIELD_KNOWN" layout="joomla.form.field.radio.switcher" default="0"><option value="0">JNO</option><option value="1">JYES</option></field>
		<field name="global_fake" type="radio" label="COM_JOOMLEAGUE_TREETO_FIELD_FAKE" layout="joomla.form.field.radio.switcher" default="0"><option value="0">JNO</option><option value="1">JYES</option></field>
		<field name="leafed" type="radio" label="COM_JOOMLEAGUE_TREETO_FIELD_LEAFED" layout="joomla.form.field.radio.switcher" default="0"><option value="0">JNO</option><option value="1">JYES</option></field>
		<field name="mirror" type="radio" label="COM_JOOMLEAGUE_TREETO_FIELD_MIRROR" layout="joomla.form.field.radio.switcher" default="0"><option value="0">JNO</option><option value="1">JYES</option></field>
		<field name="hide" type="radio" label="COM_JOOMLEAGUE_TREETO_FIELD_HIDE" layout="joomla.form.field.radio.switcher" default="0"><option value="0">JNO</option><option value="1">JYES</option></field>
	</fieldset>
	<fieldset name="publishing">
		<field name="published" type="list" label="JSTATUS" default="1"><option value="1">JPUBLISHED</option><option value="0">JUNPUBLISHED</option></field>
	</fieldset>
</form>
