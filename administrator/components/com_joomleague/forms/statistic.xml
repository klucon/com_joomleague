<?xml version='1.0' encoding='UTF-8'?>
<form>
	<fieldset name="details">
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" default="0" />
		<field name="name" type="text" label="COM_JOOMLEAGUE_FIELD_NAME" required="true" description="COM_JOOMLEAGUE_FIELD_NAME_DESCRIPTION" />
		<field name="short" type="text" label="COM_JOOMLEAGUE_STATISTIC_FIELD_SHORT" required="true" description="COM_JOOMLEAGUE_STATISTIC_FIELD_SHORT_DESCRIPTION" />
		<field name="alias" type="text" label="JFIELD_ALIAS_LABEL" description="JFIELD_ALIAS_DESC" />
		<field name="sports_type_id" type="sql" label="COM_JOOMLEAGUE_FIELD_SPORT" query="SELECT id,name FROM #__joomleague_sports_type WHERE published=1 ORDER BY name" key_field="id" value_field="name" required="true" description="COM_JOOMLEAGUE_FIELD_SPORT_DESCRIPTION" translate="true" />
		<field name="class" type="list" label="COM_JOOMLEAGUE_STATISTIC_FIELD_HANDLER" required="true" description="COM_JOOMLEAGUE_STATISTIC_FIELD_HANDLER_DESCRIPTION">
			<option value="basic">COM_JOOMLEAGUE_STATISTIC_HANDLER_BASIC</option>
			<option value="complexsum">COM_JOOMLEAGUE_STATISTIC_HANDLER_COMPLEXSUM</option>
			<option value="complexsumpergame">COM_JOOMLEAGUE_STATISTIC_HANDLER_COMPLEXSUMPERGAME</option>
			<option value="difference">COM_JOOMLEAGUE_STATISTIC_HANDLER_DIFFERENCE</option>
			<option value="eventpergame">COM_JOOMLEAGUE_STATISTIC_HANDLER_EVENTPERGAME</option>
			<option value="percentage">COM_JOOMLEAGUE_STATISTIC_HANDLER_PERCENTAGE</option>
			<option value="pergame">COM_JOOMLEAGUE_STATISTIC_HANDLER_PERGAME</option>
			<option value="sumevents">COM_JOOMLEAGUE_STATISTIC_HANDLER_SUMEVENTS</option>
			<option value="sumstats">COM_JOOMLEAGUE_STATISTIC_HANDLER_SUMSTATS</option>
			<option value="winpergame">COM_JOOMLEAGUE_STATISTIC_HANDLER_WINPERGAME</option>
		</field>
		<field name="note" type="textarea" label="COM_JOOMLEAGUE_FIELD_NOTES" description="COM_JOOMLEAGUE_FIELD_NOTES_DESCRIPTION" />
		<field name="params" type="textarea" label="COM_JOOMLEAGUE_STATISTIC_FIELD_PARAMS" filter="raw" validate="json" rows="6" default="{}" description="COM_JOOMLEAGUE_STATISTIC_FIELD_PARAMS_DESCRIPTION" />
		<field name="baseparams" type="textarea" label="COM_JOOMLEAGUE_STATISTIC_FIELD_BASEPARAMS" filter="raw" validate="json" rows="6" default="{}" description="COM_JOOMLEAGUE_STATISTIC_FIELD_BASEPARAMS_DESCRIPTION" />
	</fieldset>
	<fieldset name="media">
		<field name="icon" type="media" label="COM_JOOMLEAGUE_FIELD_ICON" directory="com_joomleague/statistics" description="COM_JOOMLEAGUE_FIELD_ICON_DESCRIPTION" />
	</fieldset>
	<fieldset name="publishing">
		<field name="published" type="list" label="JSTATUS" default="1">
			<option value="1">JPUBLISHED</option>
			<option value="0">JUNPUBLISHED</option>
		</field>
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" />
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_joomleague" section="statistic" />
	</fieldset>
</form>
