<?xml version='1.0' encoding='UTF-8'?>
<extension type="module" client="site" method="upgrade">
	<name>mod_joomleague_calendar</name>
	<author>Ondřej Klučka (https://klucon.cz)</author>
	<authorEmail>info@klucon.cz</authorEmail>
	<authorUrl>https://klucon.cz</authorUrl>
	<creationDate>2026-07</creationDate>
	<copyright>(C) 2026 Ondřej Klučka (https://klucon.cz).</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<version>6.1.0-alpha-154</version>
	<description>MOD_JOOMLEAGUE_CALENDAR_XML_DESCRIPTION</description>
	<namespace path="src">Joomleague\Module\Calendar</namespace>
	<files>
		<folder module="mod_joomleague_calendar">services</folder>
		<folder>src</folder>
		<folder>tmpl</folder>
	</files>
	<languages>
		<language tag="en-GB">language/en-GB/mod_joomleague_calendar.ini</language>
		<language tag="en-GB">language/en-GB/mod_joomleague_calendar.sys.ini</language>
	</languages>
	<config>
		<fields name="params">
			<fieldset name="basic" addfieldprefix="Joomleague\Component\Joomleague\Administrator\Field">
				<field name="project_ids" type="sql" default="" required="true" label="MOD_JOOMLEAGUE_CALENDAR_LIMITPROJECTSLBL" description="MOD_JOOMLEAGUE_CALENDAR_LIMITPROJECTSDESC" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_project ORDER BY name, id" key_field="value" value_field="text" multiple="true">
				</field>
				<field name="club_ids" type="sql" default="" label="MOD_JOOMLEAGUE_CALENDAR_LIMITCLUBSLBL" description="MOD_JOOMLEAGUE_CALENDAR_LIMITCLUBSDESC" query="SELECT id AS value, COALESCE(NULLIF(name, ''), CONCAT('ID ', id)) AS text FROM #__joomleague_club ORDER BY name, id" key_field="value" value_field="text" multiple="true">
				</field>
				<field name="team_ids" type="dynamicoptions" default="" task="projectteamsbaseoptions" parent="p" label="MOD_JOOMLEAGUE_CALENDAR_LIMITTEAMSLBL" description="MOD_JOOMLEAGUE_CALENDAR_LIMITTEAMSDESC" multiple="true" />
				<field name="time_zone" type="timezone" default="UTC" label="MOD_JOOMLEAGUE_CALENDAR_LABEL_TIMEZONE" description="MOD_JOOMLEAGUE_CALENDAR_DESC_TIMEZONE" />
				<field name="dateformat" type="text" default="l, d. F Y" label="MOD_JOOMLEAGUE_CALENDAR_LABEL_DATE_FORMAT" description="MOD_JOOMLEAGUE_CALENDAR_LABEL_DATE_FORMAT_DESC" />
				<field name="timeformat" type="text" default="H:i" label="MOD_JOOMLEAGUE_CALENDAR_LABEL_TIME_FORMAT" description="MOD_JOOMLEAGUE_CALENDAR_LABEL_TIME_FORMAT_DESC" />
				<field name="cal_start_day" type="radio" default="1" label="MOD_JOOMLEAGUE_CALENDAR_CALSTARTDAYLBL" description="MOD_JOOMLEAGUE_CALENDAR_CALSTARTDAYDESC">
					<option value="0">0</option>
					<option value="1">1</option>
					<option value="2">2</option>
					<option value="3">3</option>
					<option value="4">4</option>
					<option value="5">5</option>
					<option value="6">6</option>
				</field>
				<field name="cal_length_days" type="radio" default="2" label="MOD_JOOMLEAGUE_CALENDAR_LENGTHDAYSLBL" description="MOD_JOOMLEAGUE_CALENDAR_LENGTHDAYSDESC">
					<option value="1">1</option>
					<option value="2">2</option>
					<option value="3">3</option>
				</field>
				<field type="spacer" name="spacer_9">
				</field>
				<field name="joomleague" type="radio" default="joomleague" label="MOD_JOOMLEAGUE_CALENDAR_JOOMLEAGUECONNECTORLBL" description="MOD_JOOMLEAGUE_CALENDAR_JOOMLEAGUECONNECTORDESC">
					<option value="joomleague">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="joomleague_legacy">joomleague 0.93b</option>
				</field>
				<field name="custom_prefix" type="text" default="" label="MOD_JOOMLEAGUE_CALENDAR_CUSTOMPREFIXLBL" description="MOD_JOOMLEAGUE_CALENDAR_CUSTOMPREFIXDESC">
				</field>
				<field name="jlbirthdays" type="radio" default="0" label="MOD_JOOMLEAGUE_CALENDAR_SHOWBIRTHDAYSLBL" description="MOD_JOOMLEAGUE_CALENDAR_SHOWBIRTHDAYSDESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="jlbirthdaypix" type="radio" default="0" label="MOD_JOOMLEAGUE_CALENDAR_SHOWBIRTHDAYSPIXLBL" description="MOD_JOOMLEAGUE_CALENDAR_SHOWBIRTHDAYSPIXDESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="linkbirthday" type="radio" default="0" label="MOD_JOOMLEAGUE_CALENDAR_LINKBIRTHDAYSLBL" description="">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="birthday_text" type="text" default="Birthdays" label="MOD_JOOMLEAGUE_CALENDAR_BIRTHDAYTEXT" description="MOD_JOOMLEAGUE_CALENDAR_BIRTHDAYTEXTDESC">
				</field>
				<field name="jlmatches" type="radio" default="1" label="MOD_JOOMLEAGUE_CALENDAR_SHOWMATCHESLBL" description="MOD_JOOMLEAGUE_CALENDAR_SHOWMATCHESDESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="show_teamslist" type="radio" default="1" label="MOD_JOOMLEAGUE_CALENDAR_SHOWTEAMSLISTLBL" description="MOD_JOOMLEAGUE_CALENDAR_SHOWTEAMSLISTDESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="teamslist_option" type="text" default="Select Team" label="MOD_JOOMLEAGUE_CALENDAR_TEAMLISTDEFAULTLBL" description="MOD_JOOMLEAGUE_CALENDAR_TEAMLISTDEFAULTDESC">
				</field>
				<field name="joomleague_use_favteams" type="radio" default="0" label="MOD_JOOMLEAGUE_CALENDAR_USEJLFAVLBL" description="MOD_JOOMLEAGUE_CALENDAR_USEJLFAVDESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="team_names" type="radio" default="short_name" label="MOD_JOOMLEAGUE_CALENDAR_TEAMNAMESLBL" description="MOD_JOOMLEAGUE_CALENDAR_TEAMNAMESDESC">
					<option value="-">MOD_JOOMLEAGUE_CALENDAR_NONAMES</option>
					<option value="short_name">MOD_JOOMLEAGUE_CALENDAR_TEAMNAMESOPTION1</option>
					<option value="middle_name">MOD_JOOMLEAGUE_CALENDAR_TEAMNAMESOPTION2</option>
					<option value="name">MOD_JOOMLEAGUE_CALENDAR_TEAMNAMESOPTION3</option>
				</field>
				<field name="team_logos" type="radio" default="-" label="MOD_JOOMLEAGUE_CALENDAR_CLUBLOGOSLBL" description="MOD_JOOMLEAGUE_CALENDAR_CLUBLOGOSDESC">
					<option value="-">MOD_JOOMLEAGUE_CALENDAR_NONAMES</option>
					<option value="logo_small">MOD_JOOMLEAGUE_CALENDAR_CLUBLOGOSOPTION1</option>
					<option value="logo_middle">MOD_JOOMLEAGUE_CALENDAR_CLUBLOGOSOPTION2</option>
					<option value="logo_big">MOD_JOOMLEAGUE_CALENDAR_CLUBLOGOSOPTION3</option>
					<option value="logo_country">MOD_JOOMLEAGUE_CALENDAR_CLUBLOGOSOPTION4</option>
				</field>
				<field name="logo_height" type="text" default="0" label="MOD_JOOMLEAGUE_CALENDAR_LOGOHEIGHTLBL" description="MOD_JOOMLEAGUE_CALENDAR_LOGOHEIGHTDESC">
				</field>
				<field type="spacer" name="spacer_23">
				</field>
				<field name="livescore" type="radio" default="" label="MOD_JOOMLEAGUE_CALENDAR_LIVESCORELBL" description="MOD_JOOMLEAGUE_CALENDAR_LIVESCOREDESC">
					<option value="">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="livescore">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="prefix_livescore" type="text" default="" label="MOD_JOOMLEAGUE_CALENDAR_LIVESCPREFIXLBL" description="MOD_JOOMLEAGUE_CALENDAR_LIVESCPREFIXDESC">
				</field>
				<field type="spacer" label="Configuration for Events-Components" name="spacer_26">
				</field>
				<field name="jevents" type="radio" default="0" label="MOD_JOOMLEAGUE_CALENDAR_JEVENTSLBL" description="MOD_JOOMLEAGUE_CALENDAR_JEVENTSDESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="jevents_text" type="text" default="JEvents" label="MOD_JOOMLEAGUE_CALENDAR_JEVENTSHEADINGLBL" description="MOD_JOOMLEAGUE_CALENDAR_JEVENTSHEADINGDESC">
				</field>
				<field type="spacer" name="spacer_29">
				</field>
				<field name="convert" type="radio" default="0" label="MOD_JOOMLEAGUE_CALENDAR_CONVUTFLBL" description="MOD_JOOMLEAGUE_CALENDAR_CONVUTFDESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="lightbox" type="radio" default="0" label="MOD_JOOMLEAGUE_CALENDAR_USEBOXLBL" description="MOD_JOOMLEAGUE_CALENDAR_USEBOXDESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="lightbox_on_pageload" type="radio" default="0" label="MOD_JOOMLEAGUE_CALENDAR_USEBOXLBL_ON_PAGELOAD" description="MOD_JOOMLEAGUE_CALENDAR_USEBOX_ON_PAGELOAD_DESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="update_module" type="radio" default="1" label="MOD_JOOMLEAGUE_CALENDAR_BELOWCALLBL" description="MOD_JOOMLEAGUE_CALENDAR_BELOWCALDESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="inject" type="radio" default="0" label="MOD_JOOMLEAGUE_CALENDAR_INJECTLBL" description="MOD_JOOMLEAGUE_CALENDAR_INJECTDESC">
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NO</option>
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_YES</option>
				</field>
				<field name="inject_container" type="text" default="joomleague" label="MOD_JOOMLEAGUE_CALENDAR_INJCONTAINERLBL" description="MOD_JOOMLEAGUE_CALENDAR_INJCONTAINERDESC">
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="cache" type="list" default="1" label="MOD_JOOMLEAGUE_CALENDAR_CACHINGLBL" description="MOD_JOOMLEAGUE_CALENDAR_CACHINGDESC">
					<option value="1">MOD_JOOMLEAGUE_CALENDAR_GLOBALS</option>
					<option value="0">MOD_JOOMLEAGUE_CALENDAR_NOCACHING</option>
				</field>
				<field name="cache_time" type="text" default="900" label="MOD_JOOMLEAGUE_CALENDAR_CACHETIMELBL" description="MOD_JOOMLEAGUE_CALENDAR_CACHETIMEDESC">
				</field>
				<field name="moduleclass_sfx" type="text" default="" label="MOD_JOOMLEAGUE_CALENDAR_MODULECLASSSUFFIXLBL" description="MOD_JOOMLEAGUE_CALENDAR_MODULECLASSSUFFIXDESC">
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL" rows="3" />
			</fieldset>
		</fields>
	</config>
</extension>
