<?xml version='1.0' encoding='UTF-8'?>
<form>
	<fieldset name="details">
		<field name="id" type="text" label="JGLOBAL_FIELD_ID_LABEL" readonly="true" />
		<field name="project_id" type="hidden" />
		<field name="team_id" type="sql" label="COM_JOOMLEAGUE_PROJECT_TEAMS" query="SELECT id,name FROM #__joomleague_team ORDER BY name" key_field="id" value_field="name" required="true" description="COM_JOOMLEAGUE_PROJECT_TEAMS_DESCRIPTION" />
		<field name="division_id" type="sql" label="COM_JOOMLEAGUE_DIVISION" query="SELECT id,name FROM #__joomleague_division ORDER BY ordering,name" key_field="id" value_field="name" description="COM_JOOMLEAGUE_PROJECTTEAM_DIVISION_DESCRIPTION">
			<option value="">JNONE</option>
		</field>
		<field name="standard_playground" type="sql" label="COM_JOOMLEAGUE_MATCH_FIELD_VENUE" query="SELECT id,name FROM #__joomleague_playground ORDER BY name" key_field="id" value_field="name" description="COM_JOOMLEAGUE_MATCH_FIELD_VENUE_DESCRIPTION">
			<option value="">JNONE</option>
		</field>
		<field name="start_points" type="number" label="COM_JOOMLEAGUE_PROJECTTEAM_START_POINTS" description="COM_JOOMLEAGUE_PROJECTTEAM_START_POINTS_DESCRIPTION" />
		<field name="is_in_score" type="radio" label="COM_JOOMLEAGUE_PROJECTTEAM_IN_TABLE" layout="joomla.form.field.radio.switcher" default="1" description="COM_JOOMLEAGUE_PROJECTTEAM_IN_TABLE_DESCRIPTION">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="use_finally" type="radio" label="COM_JOOMLEAGUE_PROJECTTEAM_FINAL_VALUES" layout="joomla.form.field.radio.switcher" description="COM_JOOMLEAGUE_PROJECTTEAM_FINAL_VALUES_DESCRIPTION">
			<option value="0">JNO</option>
			<option value="1">JYES</option>
		</field>
		<field name="points_finally" type="number" label="COM_JOOMLEAGUE_PROJECTTEAM_POINTS_FINAL" description="COM_JOOMLEAGUE_PROJECTTEAM_POINTS_FINAL_DESCRIPTION" />
		<field name="neg_points_finally" type="number" label="COM_JOOMLEAGUE_PROJECTTEAM_NEG_POINTS" description="COM_JOOMLEAGUE_PROJECTTEAM_NEG_POINTS_DESCRIPTION" />
		<field name="reason" type="text" label="COM_JOOMLEAGUE_PROJECTTEAM_REASON" description="COM_JOOMLEAGUE_PROJECTTEAM_REASON_DESCRIPTION" />
		<field name="info" type="editor" height="320" width="100%" buttons="true" label="COM_JOOMLEAGUE_PROJECTTEAM_FIELD_PUBLIC_INFO" filter="safehtml" description="COM_JOOMLEAGUE_PROJECTTEAM_FIELD_PUBLIC_INFO_DESCRIPTION" />
		<field name="notes" type="textarea" rows="8" label="COM_JOOMLEAGUE_PROJECTTEAM_FIELD_INTERNAL_NOTES" filter="safehtml" description="COM_JOOMLEAGUE_PROJECTTEAM_FIELD_INTERNAL_NOTES_DESCRIPTION" />
		<field name="extended" type="textarea" label="COM_JOOMLEAGUE_FIELD_EXTENDED" filter="safehtml" description="COM_JOOMLEAGUE_FIELD_EXTENDED_DESCRIPTION" />
	</fieldset>
	<fieldset name="media">
		<field name="picture" type="media" label="COM_JOOMLEAGUE_FIELD_IMAGE" directory="com_joomleague/teams" description="COM_JOOMLEAGUE_FIELD_IMAGE_DESCRIPTION" />
	</fieldset>
	<fieldset name="publishing">
		<field name="ordering" type="number" label="JFIELD_ORDERING_LABEL" />
	</fieldset>
	<fieldset name="permissions" label="JCONFIG_PERMISSIONS_LABEL">
		<field name="rules" type="rules" label="JCONFIG_PERMISSIONS_LABEL" filter="rules" validate="rules" component="com_joomleague" section="projectteam" />
	</fieldset>
</form>
